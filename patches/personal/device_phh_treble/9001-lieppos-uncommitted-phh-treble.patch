diff --git a/lieppos_target_base.mk b/lieppos_target_base.mk
new file mode 100644
index 0000000..93a02d3
--- /dev/null
+++ b/lieppos_target_base.mk
@@ -0,0 +1,61 @@
+# Shared LieppOS GSI target boilerplate. `include`d by each per-flavor product
+# makefile (lineage_arm64_bvNE[_*].mk); the product sets PRODUCT_NAME and
+# inherits its vendor/lieppos/flavors/*.mk after this. Device stays
+# tdgsi_arm64_ab for every flavor — build.sh isolates flavors via OUT_DIR.
+
+TARGET_GAPPS_ARCH := arm64
+include build/make/target/product/aosp_arm64.mk
+$(call inherit-product, device/phh/treble/base.mk)
+
+$(call inherit-product, device/phh/treble/lineage.mk)
+
+PRODUCT_DEVICE := tdgsi_arm64_ab
+PRODUCT_BRAND := google
+PRODUCT_SYSTEM_BRAND := google
+PRODUCT_MODEL := Ulefone Thermal 29 Pro
+
+# Overwrite the inherited "emulator" characteristics
+PRODUCT_CHARACTERISTICS := device
+
+LINEAGE_BUILDTYPE := VANILLA
+LINEAGE_BUILD := GSI
+
+#EROFS
+LINEAGE_EXTRAVERSION := -EROFS
+GSI_FILE_SYSTEM_TYPE := erofs
+BOARD_EROFS_COMPRESSOR := lz4hc,9
+TARGET_PRODUCT_PROP += device/phh/treble/product.prop
+
+# Release signing
+PRODUCT_DEFAULT_DEV_CERTIFICATE := vendor/lineage-priv/keys/releasekey
+PRODUCT_OTA_PUBLIC_KEYS := vendor/lineage-priv/keys/releasekey
+PRODUCT_EXTRA_RECOVERY_KEYS := vendor/lineage-priv/keys/releasekey
+
+# Spoof to Pixel 9 Pro stock A16 (caiman).
+# PINNED — do not bump this fingerprint when real Pixel OTAs ship. MeaWallet /
+# Mastercard tokenization treats any fingerprint change as "new or upgraded
+# device" and burns one slot from the per-PAN token quota. Each bump cost a
+# Swedbank slot until quota hit and onboarding started reporting
+# "PAN provisioning count exceeded". Only bump when forced by an integrity
+# allow-list rejection, and pre-revoke unused bank tokens before doing so.
+BUILD_FINGERPRINT := google/caiman/caiman:16/BP4A.251205.006/14401865:user/release-keys
+BUILD_NUMBER := 14401865
+
+PRODUCT_BUILD_PROP_OVERRIDES += \
+    BuildId=BP4A.251205.006 \
+    BuildDesc="caiman-user 16 BP4A.251205.006 14401865 release-keys" \
+    DeviceProduct=caiman \
+    DeviceName=caiman \
+    ProductBrand=google \
+    ProductManufacturer=Google \
+    ProductModel="Pixel 9 Pro" \
+    SystemBrand=google \
+    SystemDevice=caiman \
+    SystemManufacturer=Google \
+    SystemModel="Pixel 9 Pro" \
+    SystemName=caiman \
+    ProductModelForAttestation="Pixel 9 Pro" \
+    ProductBrandForAttestation=google \
+    ProductNameForAttestation=caiman \
+    ProductDeviceForAttestation=caiman \
+    ProductManufacturerForAttestation=Google
