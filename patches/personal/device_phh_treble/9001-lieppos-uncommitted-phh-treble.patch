diff --git a/phh-on-boot.sh b/phh-on-boot.sh
index 1adb226..8f8e458 100644
--- a/phh-on-boot.sh
+++ b/phh-on-boot.sh
@@ -44,7 +44,10 @@ if [ ! -f /metadata/securize_disable ]; then
   resetprop_phh ro.warranty_bit 0
   resetprop_phh --delete ro.build.selinux
   resetprop_phh -n sys.oem_unlock_allowed 0
-  resetprop_phh -n init.svc.adbd stopped
+  # NOTE: do not spoof init.svc.adbd=stopped here. AdbDebuggingManager polls
+  # SystemService.waitForState(ADBD, RUNNING); a faked "stopped" makes that wait
+  # time out and the manager writes Settings.Global.ADB_ENABLED=0, silently
+  # killing ADB. Same reason the on-property spoof was removed from vndk.rc.
   resetprop_phh -n init.svc.flash_recovery stopped
 fi
 
@@ -53,6 +56,108 @@ vndk="$(getprop persist.sys.vndk)"
 
 [ "$(getprop vold.decrypt)" = "trigger_restart_min_framework" ] && exit 0
 
+usb_has_function() {
+    case ",$1," in
+        *",$2,"*) return 0 ;;
+        *) return 1 ;;
+    esac
+}
+
+usb_add_adb_function() {
+    cfg="$1"
+    if [ -z "$cfg" ] || [ "$cfg" = "none" ] || [ "$cfg" = "adb" ]; then
+        cfg="mtp"
+    fi
+    if usb_has_function "$cfg" adb; then
+        echo "$cfg"
+    else
+        echo "$cfg,adb"
+    fi
+}
+
+# LieppOS: persist ro.serialno across reboots and flashes.
+# Some MTK vendor init paths regenerate the serial on first boot, and a fresh
+# system-image flash can also shift derived attestation values. MeaWallet /
+# Mastercard tokenization bind to (build fingerprint + serial + attested keys);
+# any change burns one slot from the per-PAN token quota until onboarding
+# starts reporting "PAN provisioning count exceeded". Cache the first-seen
+# serial under /persist (which survives factory reset on this device) and
+# restore it on every later boot before zygote captures Build.SERIAL. Override
+# both ro.serialno and ro.boot.serialno so framework and vendor agree.
+# Force-rotate by `touch /persist/lieppos/serialno.wipe` then reboot.
+if [ ! -e /persist/lieppos/serialno.wipe ]; then
+    mkdir -p /persist/lieppos 2>/dev/null
+    if [ -s /persist/lieppos/serialno ]; then
+        saved_serial="$(cat /persist/lieppos/serialno 2>/dev/null)"
+        if [ -n "$saved_serial" ]; then
+            resetprop_phh -n ro.serialno "$saved_serial"
+            resetprop_phh -n ro.boot.serialno "$saved_serial"
+        fi
+    else
+        cur_serial="$(getprop ro.serialno)"
+        if [ -n "$cur_serial" ] && [ "$cur_serial" != "unknown" ]; then
+            echo "$cur_serial" > /persist/lieppos/serialno
+            chmod 0600 /persist/lieppos/serialno
+        fi
+    fi
+fi
+
+# LieppOS: open /dev/fm to the system uid so RevampedFMRadio (priv-app,
+# android.uid.system) can drive the MTK FM tuner via libmtkfmjni. Vendor
+# ueventd creates the node 0660 media:media; system has no access. Re-own
+# to system:media keeps mediaserver/HAL paths working while letting the
+# FM app open it. Re-runs on every boot are cheap and idempotent.
+if [ -c /dev/fm ]; then
+    chown system:media /dev/fm
+    chmod 0660 /dev/fm
+fi
+
+# LieppOS: force ADB no-auth on user release-keys builds.
+# Modern AOSP forces ro.adb.secure=1 into /system/build.prop for user builds and
+# ignores WITH_ADB_INSECURE; PRODUCT_SYSTEM_EXT_PROPERTIES does not override
+# /system/build.prop either. adbd reads ro.adb.secure once at startup, so reset
+# the prop before adbd's first start and restart any adbd that already came up.
+# This relies on resetprop_phh writing through to the ro.* property region.
+if [ "$(getprop ro.adb.secure)" != "0" ]; then
+    resetprop_phh ro.adb.secure 0
+    if [ "$(getprop init.svc.adbd)" = "running" ]; then
+        setprop ctl.restart adbd
+    fi
+fi
+
+# Some vendor USB init scripts restore only the data function (for example
+# mtp) even when persist.sys.usb.config still requests adb. Repair the active
+# config so the host sees an ADB interface without requiring Termux commands.
+usb_persist_cfg="$(getprop persist.sys.usb.config)"
+usb_current_cfg="$(getprop sys.usb.config)"
+if usb_has_function "$usb_persist_cfg" adb && ! usb_has_function "$usb_current_cfg" adb; then
+    usb_adb_cfg="$(usb_add_adb_function "$usb_current_cfg")"
+    log -t phh-on-boot "ADB persisted but current USB config is $usb_current_cfg; forcing $usb_adb_cfg"
+    setprop sys.usb.config none
+    sleep 1
+    setprop sys.usb.config "$usb_adb_cfg"
+fi
+
+# Force-apply ADB USB config when Settings.Global.adb_enabled=1 but the active
+# USB config lacks ADB. AdbService's content-observer chain on this build does
+# not reliably propagate the toggle to UsbDeviceManager.UsbHandler, so the
+# gadget keeps exposing MTP only and the host never sees an ADB interface.
+# Reading the settings DB at boot covers both reboot-with-ADB-on and the
+# observer-stale case after a Developer Options toggle.
+adb_setting="$(settings get global adb_enabled 2>/dev/null)"
+if [ "$adb_setting" = "1" ]; then
+    cur_cfg="$(getprop sys.usb.config)"
+    if ! usb_has_function "$cur_cfg" adb; then
+        usb_adb_cfg="$(usb_add_adb_function "$cur_cfg")"
+        log -t phh-on-boot "ADB_ENABLED=1 but sys.usb.config=$cur_cfg lacks adb; forcing $usb_adb_cfg"
+        setprop persist.sys.usb.config "$usb_adb_cfg"
+        setprop sys.usb.config none
+        sleep 1
+        setprop sys.usb.config "$usb_adb_cfg"
+        setprop ctl.start adbd
+    fi
+fi
