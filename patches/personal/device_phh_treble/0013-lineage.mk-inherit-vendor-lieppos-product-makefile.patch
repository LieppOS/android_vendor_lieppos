From df1c242328ef6a346496c7af54ead923341c28b7 Mon Sep 17 00:00:00 2001
From: LieppOS <lieppos@local>
Date: Mon, 27 Apr 2026 00:19:37 +0300
Subject: [PATCH] lineage.mk: inherit vendor/lieppos product makefile
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Pulls in LieppOS vendor additions (LED toggle binaries, etc) via vendor/lieppos/lieppos.mk. Also drops the oplus udfps soong_config_set line — LieppOS does not use oplus fingerprint.
---
 lineage.mk | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/lineage.mk b/lineage.mk
index 31a81e8..018d12d 100644
--- a/lineage.mk
+++ b/lineage.mk
@@ -11,4 +11,6 @@ TARGET_BOOT_ANIMATION_RES := 1080
 PRODUCT_PACKAGES += apns-conf.xml
 
 #Oplus fingerprint
-$(call soong_config_set,surfaceflinger,udfps_lib,//hardware/oplus:libudfps_extension.oplus)
+
+# LieppOS vendor additions
+$(call inherit-product, vendor/lieppos/lieppos.mk)
-- 
2.50.1

