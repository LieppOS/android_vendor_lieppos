From b681be7298d53a2d58d38037c088974cbde8075a Mon Sep 17 00:00:00 2001
From: ArnoldasMk <arnoldas.kanobi@gmail.com>
Date: Tue, 23 Jun 2026 22:08:41 +0300
Subject: [PATCH] Recents: refresh fallback Overview thumbnails on resume

When a third-party launcher is home, launcher3 serves fallback Recents via
RecentsActivity. Locking while Overview is showing calls onStop(), which trims
the task thumbnail cache (TRIM_MEMORY_UI_HIDDEN). On unlock the activity
resumes but the task list is still valid and the tasks are still marked
visible, so loadVisibleTaskData() skips re-fetching and every card renders
blank (white/black per app theme). Add RecentsView.reloadVisibleTaskData() and
call it from RecentsActivity.onResume() to force a thumbnail refresh of the
visible tasks. No-op until the task list has been applied.

Change-Id: I630a97d5020e683ef91307f929b58e2080f8e0b3
---
 .../com/android/quickstep/RecentsActivity.java   |  8 ++++++++
 .../com/android/quickstep/views/RecentsView.java | 16 ++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/quickstep/src/com/android/quickstep/RecentsActivity.java b/quickstep/src/com/android/quickstep/RecentsActivity.java
index 6cf7962e88..af601aba10 100644
--- a/quickstep/src/com/android/quickstep/RecentsActivity.java
+++ b/quickstep/src/com/android/quickstep/RecentsActivity.java
@@ -375,6 +375,14 @@ public final class RecentsActivity extends StatefulActivity<RecentsState> implem
     @Override
     protected void onResume() {
         super.onResume();
+        // onStop() trims the thumbnail cache (TRIM_MEMORY_UI_HIDDEN) when the screen turns off
+        // while Overview is showing. On resume the task list is still valid and the tasks are
+        // still marked visible, so the thumbnails would not be re-fetched and the cards render
+        // blank (white/black, depending on each app's theme). Force a refresh of the visible
+        // task thumbnails. No-op when the task list has not been applied yet.
+        if (mFallbackRecentsView != null) {
+            mFallbackRecentsView.reloadVisibleTaskData();
+        }
         AccessibilityManagerCompat.sendStateEventToTest(getBaseContext(), OVERVIEW_STATE_ORDINAL);
     }
 
diff --git a/quickstep/src/com/android/quickstep/views/RecentsView.java b/quickstep/src/com/android/quickstep/views/RecentsView.java
index 121ce44b73..009b51fcc1 100644
--- a/quickstep/src/com/android/quickstep/views/RecentsView.java
+++ b/quickstep/src/com/android/quickstep/views/RecentsView.java
@@ -2774,6 +2774,22 @@ public abstract class RecentsView<
         mHasVisibleTaskData.clear();
     }
 
+    /**
+     * Forces the currently-visible task thumbnails to be unloaded and re-fetched. Used when the
+     * task thumbnail cache may have been trimmed while Overview stayed visible (e.g. the screen
+     * turned off and back on with the fallback Recents showing). Without this, the task list is
+     * still "valid" and the tasks are still marked visible, so {@link #loadVisibleTaskData} skips
+     * re-fetching and the cards render blank.
+     */
+    public void reloadVisibleTaskData() {
+        if (mAppliedTaskListChangeId == -1) {
+            // Task list not applied yet; the normal load path will populate thumbnails.
+            return;
+        }
+        unloadVisibleTaskData(TaskView.FLAG_UPDATE_ALL);
+        loadVisibleTaskData(TaskView.FLAG_UPDATE_ALL);
+    }
+
     @Override
     public void onHighResLoadingStateChanged(boolean enabled) {
         // Preload cache when no overview task is visible (e.g. not in overview page), so when
