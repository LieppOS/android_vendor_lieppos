diff --git a/quickstep/src/com/android/quickstep/views/OverviewActionsView.java b/quickstep/src/com/android/quickstep/views/OverviewActionsView.java
index 674ce5b821..7e26cc90f6 100644
--- a/quickstep/src/com/android/quickstep/views/OverviewActionsView.java
+++ b/quickstep/src/com/android/quickstep/views/OverviewActionsView.java
@@ -146,6 +146,8 @@ public class OverviewActionsView<T extends OverlayUICallbacks> extends FrameLayo
 
     /** Container for the action buttons below a focused, non-split Overview tile. */
     protected LinearLayout mActionButtons;
+    @Nullable
+    private Button mClearAllActionButton;
     private Button mSplitButton;
     /**
      * The "save app pair" button. Currently this is the only button that is not contained in
@@ -216,8 +218,30 @@ public class OverviewActionsView<T extends OverlayUICallbacks> extends FrameLayo
         mSplitButton = findViewById(R.id.action_split);
         mSplitButton.setOnClickListener(this);
         mSaveAppPairButton.setOnClickListener(this);
+
+        // LieppOS: clear-all button in action bar
+        mClearAllActionButton = findViewById(R.id.action_clear_all);
+        if (mClearAllActionButton != null) {
+            mClearAllActionButton.setOnClickListener(this);
+            mLieppClearAllObserver = new android.database.ContentObserver(
+                    new android.os.Handler(android.os.Looper.getMainLooper())) {
+                @Override
+                public void onChange(boolean selfChange) {
+                    boolean en = android.provider.Settings.System.getInt(
+                            getContext().getContentResolver(),
+                            android.provider.Settings.System.LIEPPOS_RECENTS_CLEAR_ALL, 1) == 1;
+                    mClearAllActionButton.setVisibility(en ? VISIBLE : GONE);
+                    updateClearAllActionButtonEnabled();
+                }
+            };
+            registerLieppClearAllObserver();
+            mLieppClearAllObserver.onChange(true);
+        }
     }
 
+    private android.database.ContentObserver mLieppClearAllObserver;
+    private boolean mLieppClearAllObserverRegistered;
+
     /**
      * Set listener for callbacks on action button taps.
      *
@@ -229,10 +253,14 @@ public class OverviewActionsView<T extends OverlayUICallbacks> extends FrameLayo
 
     @Override
     public void onClick(View view) {
+        int id = view.getId();
+        if (id == R.id.action_clear_all) {
+            dismissAllTasks(view);
+            return;
+        }
         if (mCallbacks == null) {
             return;
         }
-        int id = view.getId();
         if (id == R.id.action_screenshot) {
             mCallbacks.onScreenshot();
         } else if (id == R.id.action_split) {
@@ -242,6 +270,16 @@ public class OverviewActionsView<T extends OverlayUICallbacks> extends FrameLayo
         }
     }
 
+    private void dismissAllTasks(View view) {
+        try {
+            RecentsViewContainer container = RecentsViewContainer.containerFromContext(getContext());
+            RecentsView<?, ?> recentsView = container.getOverviewPanel();
+            recentsView.dismissAllTasks(view);
+        } catch (IllegalArgumentException e) {
+            Log.w(TAG, "Could not find RecentsViewContainer for clear all", e);
+        }
+    }
+
     @Override
     protected void onConfigurationChanged(Configuration newConfig) {
         super.onConfigurationChanged(newConfig);
@@ -281,6 +319,47 @@ public class OverviewActionsView<T extends OverlayUICallbacks> extends FrameLayo
         }
         boolean isEnabled = (mDisabledFlags & ~DISABLED_ROTATED) == 0;
         LayoutUtils.setViewEnabled(this, isEnabled);
+        updateClearAllActionButtonEnabled();
+    }
+
+    private void updateClearAllActionButtonEnabled() {
+        if (mClearAllActionButton == null) {
+            return;
+        }
+        // Clear all does not depend on the focused task thumbnail. Keep it unavailable only while
+        // Recents is actively scrolling, where dismissing the stack can race page bookkeeping.
+        boolean enabled = (mDisabledFlags & DISABLED_SCROLLING) == 0;
+        if (enabled) {
+            setEnabled(true);
+            mActionButtons.setEnabled(true);
+        }
+        mClearAllActionButton.setEnabled(enabled);
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        registerLieppClearAllObserver();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        if (mLieppClearAllObserverRegistered) {
+            getContext().getContentResolver().unregisterContentObserver(mLieppClearAllObserver);
+            mLieppClearAllObserverRegistered = false;
+        }
+    }
+
+    private void registerLieppClearAllObserver() {
+        if (mLieppClearAllObserver == null || mLieppClearAllObserverRegistered) {
+            return;
+        }
+        getContext().getContentResolver().registerContentObserver(
+                android.provider.Settings.System.getUriFor(
+                        android.provider.Settings.System.LIEPPOS_RECENTS_CLEAR_ALL),
+                false, mLieppClearAllObserver);
+        mLieppClearAllObserverRegistered = true;
     }
 
     /**
