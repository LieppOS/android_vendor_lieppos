From e00912b18ae18bb7a6158933e9786fb35ab0f348 Mon Sep 17 00:00:00 2001
From: LieppOS <lieppos@local>
Date: Sat, 30 May 2026 17:32:23 +0300
Subject: [PATCH] LieppOS uncommitted WIP: packages/modules/adb

Change-Id: Icabc241d8401e699352a5b592c031133e9fbc202
---
 daemon/main.cpp            | 45 ++++++++++++++++-----------
 daemon/restart_service.cpp | 12 +++++++
 root/adbroot_service.cpp   | 64 ++++++++++++++++++++++++--------------
 3 files changed, 79 insertions(+), 42 deletions(-)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index 805816f6..939a5da6 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -64,33 +64,33 @@ static const char* root_seclabel = nullptr;
 static const char* tim_seclabel = nullptr;
 
 static bool should_drop_privileges() {
-    // The properties that affect `adb root` and `adb unroot` are ro.secure and
-    // ro.debuggable. In this context the names don't make the expected behavior
-    // particularly obvious.
-    //
-    // ro.debuggable:
-    //   Allowed to become root, but not necessarily the default. Set to 1 on
-    //   eng and userdebug builds.
-    //
-    // ro.secure:
-    //   Drop privileges by default. Set to 1 on userdebug and user builds.
+    // ro.secure drops privileges by default. LieppOS still honors explicit
+    // adb root/unroot requests on user builds.
     bool ro_secure = android::base::GetBoolProperty("ro.secure", true);
-    bool ro_debuggable = ANDROID_DEBUGGABLE || __android_log_is_debuggable();
 
     // Drop privileges if ro.secure is set...
     bool drop = ro_secure;
 
-    // ... except "adb root" lets you keep privileges in a debuggable build.
+    // LieppOS: allow explicit adb-root on user builds too when the product
+    // opts in. Rooted user-build adbd is kept in the adbd SELinux domain below;
+    // switching to the su domain is what breaks ADB on production policy.
     std::string prop = android::base::GetProperty("service.adb.root", "");
-    bool adb_root = (prop == "1");
+    bool lieppos = android::base::GetBoolProperty("ro.lieppos.adb_root_supported", false);
+    bool debuggable = ANDROID_DEBUGGABLE || __android_log_is_debuggable();
+    bool adb_root = (prop == "1") && (debuggable || lieppos);
     bool adb_unroot = (prop == "0");
-    if (ro_debuggable && adb_root) {
+    if (adb_root) {
         drop = false;
     }
     // ... and "adb unroot" lets you explicitly drop privileges.
     if (adb_unroot) {
         drop = true;
     }
+    LOG(INFO) << "LieppOS should_drop_privileges: ro.secure=" << ro_secure
+              << " service.adb.root='" << prop << "'"
+              << " ro.lieppos.adb_root_supported=" << lieppos
+              << " debuggable=" << debuggable
+              << " -> drop=" << drop;
 
     return drop;
 }
@@ -173,7 +173,13 @@ static void drop_privileges() {
         // minijail_enter() will abort if any priv-dropping step fails.
         minijail_enter(jail.get());
 
-        if (root_seclabel != nullptr) {
+        // On LieppOS user builds, keep rooted adbd in u:r:adbd:s0. Android's
+        // --root_seclabel is u:r:su:s0, but su is not the broad debug domain on
+        // user builds and adbd can lose permissions/crash-loop there.
+        bool skip_root_seclabel = android::base::GetBoolProperty(
+                "ro.lieppos.adb_root_supported", false)
+                && !ANDROID_DEBUGGABLE && !__android_log_is_debuggable();
+        if (root_seclabel != nullptr && !skip_root_seclabel) {
             if (selinux_android_setcon(root_seclabel) < 0) {
                 // If we failed to become root, don't try again to avoid a
                 // restart loop.
@@ -219,9 +225,12 @@ int adbd_main() {
     // descriptor will always be open.
     adbd_cloexec_auth_socket();
 
-    // Allow boot scripts to control authentication via ro.adb.secure.
-    // Default to requiring auth when the property is absent.
-    auth_required = android::base::GetBoolProperty("ro.adb.secure", true);
+    // Allow boot scripts/build properties to control authentication.
+    // LieppOS exposes explicit ADB controls on user builds, and some GSI
+    // devices do not reliably surface the framework authorization dialog.
+    auth_required = android::base::GetBoolProperty(
+            "ro.adb.secure",
+            !android::base::GetBoolProperty("ro.lieppos.adb_root_supported", false));
 
     // Our external storage path may be different than apps, since
     // we aren't able to bind mount after dropping root.
diff --git a/daemon/restart_service.cpp b/daemon/restart_service.cpp
index 8934db30..453cdd34 100644
--- a/daemon/restart_service.cpp
+++ b/daemon/restart_service.cpp
@@ -25,6 +25,8 @@
 
 #include <unistd.h>
 
+#include <thread>
+
 #include <android-base/logging.h>
 #include <android-base/properties.h>
 #include <android-base/stringprintf.h>
@@ -32,6 +34,14 @@
 
 #include "adb_io.h"
 #include "adb_unique_fd.h"
+#include "sysdeps/chrono.h"
+
+static void restart_adbd_process() {
+#if defined(__ANDROID__)
+    std::this_thread::sleep_for(1s);
+    _exit(0);
+#endif
+}
 
 void restart_root_service(unique_fd fd) {
     if (getuid() == 0) {
@@ -69,6 +79,7 @@ void restart_root_service(unique_fd fd) {
     LOG(INFO) << "adbd restarting as root";
     android::base::SetProperty("service.adb.root", "1");
     WriteFdExactly(fd.get(), "restarting adbd as root\n");
+    restart_adbd_process();
 }
 
 void restart_unroot_service(unique_fd fd) {
@@ -80,6 +91,7 @@ void restart_unroot_service(unique_fd fd) {
     LOG(INFO) << "adbd restarting as nonroot";
     android::base::SetProperty("service.adb.root", "0");
     WriteFdExactly(fd.get(), "restarting adbd as non root\n");
+    restart_adbd_process();
 }
 
 void restart_tcp_service(unique_fd fd, int port) {
diff --git a/root/adbroot_service.cpp b/root/adbroot_service.cpp
index 8d80d37d..9b7aed91 100644
--- a/root/adbroot_service.cpp
+++ b/root/adbroot_service.cpp
@@ -72,9 +72,7 @@ namespace android {
 namespace adbroot {
 
 using ::android::AutoMutex;
-using ::android::base::ReadFileToString;
 using ::android::base::SetProperty;
-using ::android::base::Trim;
 using ::android::base::WriteStringToFile;
 
 static inline bool isAutomotive(uid_t uid) {
@@ -84,10 +82,10 @@ static inline bool isAutomotive(uid_t uid) {
 }
 
 ADBRootService::ADBRootService() : enabled_(false) {
-    std::string buf;
-    if (ReadFileToString(kStoragePath + kEnabled, &buf)) {
-        enabled_ = Trim(buf) == "1";
-    }
+    // LieppOS: do not persist adb-root across boots. USB/ADB should always boot
+    // in the safe non-root state; the QS tile or `adb root` can explicitly
+    // request root after the device is online.
+    WriteStringToFile("0", kStoragePath + kEnabled);
 }
 
 void ADBRootService::Register() {
@@ -101,12 +99,17 @@ void ADBRootService::Register() {
 }
 
 ndk::ScopedAStatus ADBRootService::isSupported(bool* _aidl_return) {
-    uid_t uid = AIBinder_getCallingUid();
-    if (uid != AID_SYSTEM && uid != AID_SHELL && !isAutomotive(uid)) {
-        return SecurityException("Caller must be system or shell");
-    }
+    // LieppOS: drop the uid check. SystemUI on this ROM is a platform_app
+    // (app uid range, e.g. 10149), not AID_SYSTEM, so the original
+    // system-or-shell gate rejected the QS tile entirely. SELinux
+    // (adbroot_service:service_manager find) is the real access gate;
+    // only callers in adbd / system_server / platform_app domains can
+    // reach this binder.
 
     AutoMutex _l(lock_);
+    // LieppOS intentionally exposes ADB root on user builds when enabled by the
+    // product property. The daemon side keeps rooted adbd in the adbd SELinux
+    // domain on user builds so it does not crash by transitioning to su.
     *_aidl_return = ANDROID_DEBUGGABLE || __android_log_is_debuggable() ||
             ::android::base::GetBoolProperty(kLieppOSAdbRootSupported, false);
     return ndk::ScopedAStatus::ok();
@@ -114,34 +117,47 @@ ndk::ScopedAStatus ADBRootService::isSupported(bool* _aidl_return) {
 
 ndk::ScopedAStatus ADBRootService::setEnabled(bool enabled) {
     uid_t uid = AIBinder_getCallingUid();
-    if (uid != AID_SYSTEM && !isAutomotive(uid)) {
-        return SecurityException("Caller must be system");
-    }
+    pid_t pid = AIBinder_getCallingPid();
+    LOG(INFO) << "LieppOS setEnabled(" << (enabled ? "true" : "false")
+              << ") from uid=" << uid << " pid=" << pid
+              << " current enabled_=" << enabled_;
+    // SELinux gates which domains can reach this binder; accept any
+    // caller that got through (system_server, adbd, SystemUI platform_app).
 
     AutoMutex _l(lock_);
 
-    if (enabled_ != enabled) {
-        enabled_ = enabled;
-        WriteStringToFile(std::to_string(enabled), kStoragePath + kEnabled);
+    const bool adbRootAllowed = ANDROID_DEBUGGABLE || __android_log_is_debuggable() ||
+            ::android::base::GetBoolProperty(kLieppOSAdbRootSupported, false);
+    const bool safeEnabled = adbRootAllowed && enabled;
+
+    LOG(INFO) << "LieppOS setEnabled: adbRootAllowed=" << adbRootAllowed
+              << " safeEnabled=" << safeEnabled;
 
-        // Turning off adb root, restart adbd.
-        if (!enabled) {
-            SetProperty("service.adb.root", "0");
-            SetProperty("ctl.restart", "adbd");
-        }
+    if (enabled_ != safeEnabled) {
+        enabled_ = safeEnabled;
+        WriteStringToFile(std::to_string(safeEnabled), kStoragePath + kEnabled);
     }
 
+    // Restart on every setEnabled(), even if the stored state did not change,
+    // so callers can use adbroot_service as the safe adbd restart path instead
+    // of trying to write protected init properties directly from app_process.
+    SetProperty("service.adb.root", safeEnabled ? "1" : "0");
+    SetProperty("ctl.restart", "adbd");
+    LOG(INFO) << "LieppOS setEnabled: wrote service.adb.root="
+              << (safeEnabled ? "1" : "0") << " and ctl.restart adbd";
+
     return ndk::ScopedAStatus::ok();
 }
 
 ndk::ScopedAStatus ADBRootService::getEnabled(bool* _aidl_return) {
     uid_t uid = AIBinder_getCallingUid();
-    if (uid != AID_SYSTEM && uid != AID_SHELL && !isAutomotive(uid)) {
-        return SecurityException("Caller must be system or shell");
-    }
+    pid_t pid = AIBinder_getCallingPid();
+    // SELinux gates access; trust it.
 
     AutoMutex _l(lock_);
     *_aidl_return = enabled_;
+    LOG(INFO) << "LieppOS getEnabled() = " << enabled_
+              << " (caller uid=" << uid << " pid=" << pid << ")";
     return ndk::ScopedAStatus::ok();
 }
 
