From ba60890356e4f2784b411a5ca6bf603472265c79 Mon Sep 17 00:00:00 2001
From: LieppOS <lieppos@local>
Date: Sun, 24 May 2026 15:06:22 +0300
Subject: [PATCH] LieppOS uncommitted WIP: packages/modules/adb

Change-Id: I4b8e2565a021af79c95ee5b97fd1428f20190028
---
 daemon/main.cpp            | 26 ++++++++++----------------
 daemon/restart_service.cpp | 12 ++++++++++++
 root/adbroot_service.cpp   | 24 ++++++++++++++++++------
 3 files changed, 40 insertions(+), 22 deletions(-)

diff --git a/daemon/main.cpp b/daemon/main.cpp
index 805816f6..ee2e9ae4 100644
--- a/daemon/main.cpp
+++ b/daemon/main.cpp
@@ -64,27 +64,18 @@ static const char* root_seclabel = nullptr;
 static const char* tim_seclabel = nullptr;
 
 static bool should_drop_privileges() {
-    // The properties that affect `adb root` and `adb unroot` are ro.secure and
-    // ro.debuggable. In this context the names don't make the expected behavior
-    // particularly obvious.
-    //
-    // ro.debuggable:
-    //   Allowed to become root, but not necessarily the default. Set to 1 on
-    //   eng and userdebug builds.
-    //
-    // ro.secure:
-    //   Drop privileges by default. Set to 1 on userdebug and user builds.
+    // ro.secure drops privileges by default. LieppOS still honors explicit
+    // adb root/unroot requests on user builds.
     bool ro_secure = android::base::GetBoolProperty("ro.secure", true);
-    bool ro_debuggable = ANDROID_DEBUGGABLE || __android_log_is_debuggable();
 
     // Drop privileges if ro.secure is set...
     bool drop = ro_secure;
 
-    // ... except "adb root" lets you keep privileges in a debuggable build.
+    // LieppOS: allow the explicit "adb root" request on user builds too.
     std::string prop = android::base::GetProperty("service.adb.root", "");
     bool adb_root = (prop == "1");
     bool adb_unroot = (prop == "0");
-    if (ro_debuggable && adb_root) {
+    if (adb_root) {
         drop = false;
     }
     // ... and "adb unroot" lets you explicitly drop privileges.
@@ -219,9 +210,12 @@ int adbd_main() {
     // descriptor will always be open.
     adbd_cloexec_auth_socket();
 
-    // Allow boot scripts to control authentication via ro.adb.secure.
-    // Default to requiring auth when the property is absent.
-    auth_required = android::base::GetBoolProperty("ro.adb.secure", true);
+    // Allow boot scripts/build properties to control authentication.
+    // LieppOS exposes explicit ADB controls on user builds, and some GSI
+    // devices do not reliably surface the framework authorization dialog.
+    auth_required = android::base::GetBoolProperty(
+            "ro.adb.secure",
+            !android::base::GetBoolProperty("ro.lieppos.adb_root_supported", false));
 
     // Our external storage path may be different than apps, since
     // we aren't able to bind mount after dropping root.
diff --git a/daemon/restart_service.cpp b/daemon/restart_service.cpp
index 8934db30..453cdd34 100644
--- a/daemon/restart_service.cpp
+++ b/daemon/restart_service.cpp
@@ -25,6 +25,8 @@
 
 #include <unistd.h>
 
+#include <thread>
+
 #include <android-base/logging.h>
 #include <android-base/properties.h>
 #include <android-base/stringprintf.h>
@@ -32,6 +34,14 @@
 
 #include "adb_io.h"
 #include "adb_unique_fd.h"
+#include "sysdeps/chrono.h"
+
+static void restart_adbd_process() {
+#if defined(__ANDROID__)
+    std::this_thread::sleep_for(1s);
+    _exit(0);
+#endif
+}
 
 void restart_root_service(unique_fd fd) {
     if (getuid() == 0) {
@@ -69,6 +79,7 @@ void restart_root_service(unique_fd fd) {
     LOG(INFO) << "adbd restarting as root";
     android::base::SetProperty("service.adb.root", "1");
     WriteFdExactly(fd.get(), "restarting adbd as root\n");
+    restart_adbd_process();
 }
 
 void restart_unroot_service(unique_fd fd) {
@@ -80,6 +91,7 @@ void restart_unroot_service(unique_fd fd) {
     LOG(INFO) << "adbd restarting as nonroot";
     android::base::SetProperty("service.adb.root", "0");
     WriteFdExactly(fd.get(), "restarting adbd as non root\n");
+    restart_adbd_process();
 }
 
 void restart_tcp_service(unique_fd fd, int port) {
diff --git a/root/adbroot_service.cpp b/root/adbroot_service.cpp
index 8d80d37d..58b7abb4 100644
--- a/root/adbroot_service.cpp
+++ b/root/adbroot_service.cpp
@@ -88,6 +88,15 @@ ADBRootService::ADBRootService() : enabled_(false) {
     if (ReadFileToString(kStoragePath + kEnabled, &buf)) {
         enabled_ = Trim(buf) == "1";
     }
+    // LieppOS: do NOT auto-apply persisted adb-root at boot. adbd's
+    // --root_seclabel runs the WHOLE adbd process as u:r:su:s0 when rooted; on
+    // a user build the su domain is unprivileged (system/sepolicy su.te is
+    // entirely userdebug_or_eng, and "permissive su" is forbidden on user
+    // builds), so su is denied `listen` on the adbd-labeled control socket and
+    // adbd_auth aborts (SIGABRT) in a crash-loop with ADB dead. adbd must start
+    // as adbd:s0. We still load enabled_ above so the tile/Developer Options UI
+    // reflects the persisted state; root is (re)applied on demand via
+    // setEnabled() rather than at startup.
 }
 
 void ADBRootService::Register() {
@@ -123,12 +132,15 @@ ndk::ScopedAStatus ADBRootService::setEnabled(bool enabled) {
     if (enabled_ != enabled) {
         enabled_ = enabled;
         WriteStringToFile(std::to_string(enabled), kStoragePath + kEnabled);
-
-        // Turning off adb root, restart adbd.
-        if (!enabled) {
-            SetProperty("service.adb.root", "0");
-            SetProperty("ctl.restart", "adbd");
-        }
+        // LieppOS: never run adbd as root. adbd's --root_seclabel runs the whole
+        // process as u:r:su:s0, but on a user build the su domain is unprivileged
+        // (system/sepolicy su.te is entirely userdebug_or_eng) and adbd aborts on
+        // its control-socket listen() -> crash-loop with ADB dead. Force adbd to
+        // stay in the adbd domain regardless of the toggle so ADB keeps working;
+        // root remains available via KernelSU. enabled_ is still persisted for UI
+        // idempotency, but service.adb.root is never set to 1.
+        SetProperty("service.adb.root", "0");
+        SetProperty("ctl.restart", "adbd");
     }
 
     return ndk::ScopedAStatus::ok();
-- 
