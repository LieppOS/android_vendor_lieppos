From 923ec260c3eedbf7ca9e9f05a5ca691903bfd767 Mon Sep 17 00:00:00 2001
From: LieppOS <lieppos@local>
Date: Sun, 24 May 2026 15:06:22 +0300
Subject: [PATCH] LieppOS uncommitted WIP: system/sepolicy

Change-Id: Id56bcf98373b5fc8de1969330fd92a3a9d9c8414
---
 private/adbd.te | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/private/adbd.te b/private/adbd.te
index 6bef6f8bf..a1a3b6abb 100644
--- a/private/adbd.te
+++ b/private/adbd.te
@@ -11,6 +11,16 @@ domain_auto_trans(adbd, shell_exec, shell)
 # Allow adbd inside vm to forward vm's vsock.
 allow adbd self:vsock_socket { create_socket_perms_no_ioctl listen accept };
 
+# LieppOS: adbd_auth listens/accepts on the adbd control socket
+# (/dev/socket/adbd). On this device init labels that socket *object*
+# u:object_r:adbd_socket:s0 rather than the adbd domain, so the generic
+# `allow domain self:unix_stream_socket { ... listen accept }` in domain.te
+# does not cover it. Without this rule listen() returns EACCES and adbd
+# aborts (SIGABRT) in a crash-loop; the denial is invisible because vendor
+# policy dontaudits it. Grant the stream-socket ops adbd performs on its
+# own control socket (init still owns create/bind).
+allow adbd adbd_socket:unix_stream_socket { getattr read write listen accept };
+
 # Allow adb to setcon() to tradeinmode.
 allow adbd self:process setcurrent;
 allow adbd adbd_tradeinmode:process dyntransition;
