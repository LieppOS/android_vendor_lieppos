+import lineageos.providers.LineageSettings
 
 // LINT.IfChange
 class BatteryPercentageSwitchPreference :
@@ -80,10 +81,48 @@ class BatteryPercentageSwitchPreference :
             context.resources.getBoolean(
                 com.android.internal.R.bool.config_defaultBatteryPercentageSetting
             ) as T
+
+        override fun <T : Any> getValue(key: String, valueType: Class<T>): T? {
+            if (key == KEY && valueType == Boolean::class.javaObjectType) {
+                return (LineageSettings.System.getInt(
+                    context.contentResolver,
+                    LineageSettings.System.STATUS_BAR_SHOW_BATTERY_PERCENT,
+                    if (context.resources.getBoolean(
+                            com.android.internal.R.bool.config_defaultBatteryPercentageSetting
+                        )
+                    ) {
+                        LINEAGE_BATTERY_PERCENT_NEXT_TO_ICON
+                    } else {
+                        LINEAGE_BATTERY_PERCENT_HIDDEN
+                    },
+                ) != LINEAGE_BATTERY_PERCENT_HIDDEN) as T
+            }
+            return super.getValue(key, valueType)
+        }
+
+        override fun <T : Any> setValue(key: String, valueType: Class<T>, value: T?) {
+            if (key == KEY && valueType == Boolean::class.javaObjectType) {
+                val showPercentage = value as? Boolean ?: false
+                settingsStore.setValue(key, valueType, value)
+                LineageSettings.System.putInt(
+                    context.contentResolver,
+                    LineageSettings.System.STATUS_BAR_SHOW_BATTERY_PERCENT,
+                    if (showPercentage) {
+                        LINEAGE_BATTERY_PERCENT_NEXT_TO_ICON
+                    } else {
+                        LINEAGE_BATTERY_PERCENT_HIDDEN
+                    },
+                )
+                return
+            }
+            super.setValue(key, valueType, value)
+        }
     }
 
     companion object {
         const val KEY = Settings.System.SHOW_BATTERY_PERCENT
+        private const val LINEAGE_BATTERY_PERCENT_HIDDEN = 0
+        private const val LINEAGE_BATTERY_PERCENT_NEXT_TO_ICON = 2
     }
