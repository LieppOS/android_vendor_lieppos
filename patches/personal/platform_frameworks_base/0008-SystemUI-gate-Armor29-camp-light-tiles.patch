@@ -123,6 +132,7 @@ public class SuperFlashlightTile extends QSTileImpl<BooleanState> {
 
     @Override
     protected void handleClick(@Nullable Expandable expandable) {
+        if (!isAvailable()) return;
         if (mSosRunning) {
             stopSos(true);
             refreshSoon();
@@ -146,22 +156,25 @@ public class SuperFlashlightTile extends QSTileImpl<BooleanState> {
     }
 
     protected void handleSecondaryClick(@Nullable Expandable expandable) {
