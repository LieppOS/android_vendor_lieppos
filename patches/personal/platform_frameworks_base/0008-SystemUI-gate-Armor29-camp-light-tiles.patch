From 220a075320a54a50534a4333e36d754a8bcbade1 Mon Sep 17 00:00:00 2001
From: LieppOS <lieppos@local>
Date: Fri, 12 Jun 2026 01:16:11 +0300
Subject: [PATCH] SystemUI: gate Armor 29 camp-light tiles on
 persist.lieppos.armor29 props

RedLightTile/BlueLightTile gate on persist.lieppos.armor29.camp_lights,
SuperFlashlightTile on persist.lieppos.armor29.super_flashlight: tiles
report unavailable and ignore clicks until the gate is enabled in
Settings -> LieppOS -> Phone specific patches -> Armor 29.

Change-Id: Ib3451a35c1ec8c8adc7aea5cbe974acde31b1036
---
 .../systemui/qs/tiles/BlueLightTile.java      | 18 +++++++++++++++---
 .../systemui/qs/tiles/RedLightTile.java       | 18 +++++++++++++++---
 .../qs/tiles/SuperFlashlightTile.java         | 19 ++++++++++++++++---
 3 files changed, 46 insertions(+), 9 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/qs/tiles/BlueLightTile.java b/packages/SystemUI/src/com/android/systemui/qs/tiles/BlueLightTile.java
index e89071129507..bec2dafab8b9 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/tiles/BlueLightTile.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/BlueLightTile.java
@@ -4,6 +4,7 @@ import android.content.Context;
 import android.content.Intent;
 import android.os.Handler;
 import android.os.Looper;
+import android.os.SystemProperties;
 import android.service.quicksettings.Tile;
 import android.widget.Switch;
 
@@ -28,6 +29,9 @@ import javax.inject.Inject;
 public class BlueLightTile extends QSTileImpl<BooleanState> {
     public static final String TILE_SPEC = "bluelight";
 
+    // Armor 29 hardware-feature gate (Settings -> LieppOS -> Phone specific patches).
+    private static final String GATE_PROP = "persist.lieppos.armor29.camp_lights";
+
     @Inject
     public BlueLightTile(
             QSHost host,
@@ -43,7 +47,12 @@ public class BlueLightTile extends QSTileImpl<BooleanState> {
     ) {
         super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager,
                 metricsLogger, statusBarStateController, activityStarter, qsLogger);
-        YftCampLightLeds.syncHardwareFromSetting(context);
+        if (isAvailable()) YftCampLightLeds.syncHardwareFromSetting(context);
+    }
+
+    @Override
+    public boolean isAvailable() {
+        return SystemProperties.getBoolean(GATE_PROP, false);
     }
 
     @Override
@@ -56,12 +65,14 @@ public class BlueLightTile extends QSTileImpl<BooleanState> {
 
     @Override
     protected void handleLongClick(@Nullable Expandable expandable) {
+        if (!isAvailable()) return;
         YftCampLightLeds.setBlueFlashy(mContext);
         refreshState();
     }
 
     @Override
     protected void handleClick(@Nullable Expandable expandable) {
+        if (!isAvailable()) return;
         YftCampLightLeds.toggleBlue(mContext);
         refreshState();
     }
@@ -73,11 +84,12 @@ public class BlueLightTile extends QSTileImpl<BooleanState> {
 
     @Override
     protected void handleUpdateState(BooleanState state, Object arg) {
-        boolean on = YftCampLightLeds.isBlueOn(mContext);
+        boolean on = isAvailable() && YftCampLightLeds.isBlueOn(mContext);
         state.value = on;
         state.label = getTileLabel();
         state.icon = maybeLoadResourceIcon(R.drawable.qs_blue_light_icon);
-        state.state = on ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+        state.state = !isAvailable() ? Tile.STATE_UNAVAILABLE
+                : on ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
         state.secondaryLabel = YftCampLightLeds.isBlueFlashy(mContext) ? "Flashy" : null;
         state.contentDescription = state.label;
         state.expandedAccessibilityClassName = Switch.class.getName();
