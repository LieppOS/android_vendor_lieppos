@@ -34,6 +35,9 @@ public class SuperFlashlightTile extends QSTileImpl<BooleanState> {
     public static final String TILE_SPEC = "superflashlight";
     private static final String TAG = "SuperFlashlightTile";
 
+    // Armor 29 hardware-feature gate (Settings -> LieppOS -> Phone specific patches).
+    private static final String GATE_PROP = "persist.lieppos.armor29.super_flashlight";
+
     private static final String MODE =
