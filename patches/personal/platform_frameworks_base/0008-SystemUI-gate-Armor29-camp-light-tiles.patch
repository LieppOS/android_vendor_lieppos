         mMainHandler = mainHandler;
-        int b = readSysfsInt(BRIGHT);
+        int b = isAvailable() ? readSysfsInt(BRIGHT) : 0;
         if (b != 0) {
             mSteadyOn = true;
             mLevelIndex = 0;
         }
     }
 
