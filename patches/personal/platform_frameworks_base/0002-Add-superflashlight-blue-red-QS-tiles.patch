--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/SuperFlashlightTile.java
@@ -0,0 +1,247 @@
+package com.android.systemui.qs.tiles;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.Handler;
+import android.os.Looper;
+import android.service.quicksettings.Tile;
+import android.util.Log;
+import android.widget.Switch;
+
+import androidx.annotation.Nullable;
+
+import com.android.internal.logging.MetricsLogger;
+import com.android.systemui.animation.Expandable;
+import com.android.systemui.dagger.qualifiers.Background;
+import com.android.systemui.dagger.qualifiers.Main;
+import com.android.systemui.plugins.ActivityStarter;
+import com.android.systemui.plugins.FalsingManager;
+import com.android.systemui.plugins.qs.QSTile.BooleanState;
+import com.android.systemui.plugins.statusbar.StatusBarStateController;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.QsEventLogger;
+import com.android.systemui.qs.logging.QSLogger;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+import com.android.systemui.res.R;
+
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+
+import javax.inject.Inject;
+
+public class SuperFlashlightTile extends QSTileImpl<BooleanState> {
+    public static final String TILE_SPEC = "superflashlight";
+    private static final String TAG = "SuperFlashlightTile";
+
+    private static final String MODE =
+            "/sys/devices/platform/yft_camplight/camplight_mode";
+    private static final String BRIGHT =
+            "/sys/devices/platform/yft_camplight/camplight_set_brightness";
+
+    private static final int[] LEVELS = new int[]{ 1, 25, 50, 75, 90 };
+
+    private static final int MODE_OFF = 0;
+    private static final int MODE_ON  = 1;
+
+    private static final int DOT = 200;
+    private static final int DASH = 600;
+    private static final int INTRA = 200;
+    private static final int LETTER_GAP = 600;
+    private static final int WORD_GAP = 1400;
+
+    private static final int[] SOS_PATTERN = new int[] {
+            DOT, -INTRA, DOT, -INTRA, DOT, -LETTER_GAP,
+            DASH, -INTRA, DASH, -INTRA, DASH, -LETTER_GAP,
+            DOT, -INTRA, DOT, -INTRA, DOT, -WORD_GAP
+    };
+
+    private final Handler mMainHandler;
+
+    private int mLevelIndex = -1;
+    private boolean mSteadyOn = false;
+
+    private boolean mSosRunning = false;
+    private int mSosStep = 0;
+
+    private int mSavedLevelIndex = -1;
+    private boolean mSavedSteadyOn = false;
+
+    private final Runnable mSosRunnable = new Runnable() {
+        @Override
+        public void run() {
+            if (!mSosRunning) return;
+            if (mSosStep >= SOS_PATTERN.length) mSosStep = 0;
+            int step = SOS_PATTERN[mSosStep++];
+            if (step > 0) {
+                writeSysfs(BRIGHT, Integer.toString(LEVELS[LEVELS.length - 1]));
+                writeSysfs(MODE, Integer.toString(MODE_ON));
+                mMainHandler.postDelayed(this, step);
+            } else {
+                writeSysfs(MODE, Integer.toString(MODE_OFF));
+                writeSysfs(BRIGHT, "0");
+                mMainHandler.postDelayed(this, -step);
+            }
+        }
+    };
+
+    @Inject
+    public SuperFlashlightTile(
+            QSHost host,
+            QsEventLogger uiEventLogger,
+            @Background Looper backgroundLooper,
+            @Main Handler mainHandler,
+            FalsingManager falsingManager,
+            MetricsLogger metricsLogger,
+            StatusBarStateController statusBarStateController,
+            ActivityStarter activityStarter,
+            QSLogger qsLogger,
+            Context context
+    ) {
+        super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager,
+                metricsLogger, statusBarStateController, activityStarter, qsLogger);
+        mMainHandler = mainHandler;
+        int b = readSysfsInt(BRIGHT);
+        if (b != 0) {
+            mSteadyOn = true;
+            mLevelIndex = 0;
+        }
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_super_flashlight_label);
+    }
+
+    @Override
+    public Intent getLongClickIntent() { return null; }
+
+    @Override
+    protected void handleSetListening(boolean listening) {
+        if (!listening) stopSos(false);
+    }
+
+    @Override
+    protected void handleClick(@Nullable Expandable expandable) {
+        if (mSosRunning) {
+            stopSos(true);
+            refreshSoon();
+            return;
+        }
+        if (!mSteadyOn) {
+            mLevelIndex = 0;
+            mSteadyOn = true;
+            applySteadyLevel(mLevelIndex);
+        } else {
+            mLevelIndex++;
+            if (mLevelIndex >= LEVELS.length) {
+                mLevelIndex = -1;
+                mSteadyOn = false;
+                turnOff();
+            } else {
+                applySteadyLevel(mLevelIndex);
+            }
+        }
+        refreshSoon();
+    }
+
+    protected void handleSecondaryClick(@Nullable Expandable expandable) {
+        startSos();
+        refreshSoon();
+    }
+
+    protected void handleLongClick(@Nullable Expandable expandable) {
+        startSos();
+        refreshSoon();
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        boolean active = mSosRunning || mSteadyOn;
+        state.value = active;
+        state.label = getTileLabel();
+        state.icon = maybeLoadResourceIcon(R.drawable.qs_super_flashlight_icon);
+        state.state = active ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+        state.contentDescription = state.label;
+        state.expandedAccessibilityClassName = Switch.class.getName();
+        try {
+            if (mSosRunning) {
+                state.secondaryLabel = "SOS";
+            } else if (mSteadyOn && mLevelIndex >= 0 && mLevelIndex < LEVELS.length) {
+                state.secondaryLabel = String.valueOf(LEVELS[mLevelIndex]);
+            } else {
+                state.secondaryLabel = null;
+            }
+        } catch (Throwable ignored) {}
+    }
+
+    @Override
+    public BooleanState newTileState() { return new BooleanState(); }
+
+    @Override
+    public int getMetricsCategory() { return 0; }
+
+    private void refreshSoon() {
+        refreshState();
+        mMainHandler.postDelayed(this::refreshState, 120);
+        mMainHandler.postDelayed(this::refreshState, 350);
+    }
+
+    private void startSos() {
+        if (mSosRunning) return;
+        mSavedSteadyOn = mSteadyOn;
+        mSavedLevelIndex = mLevelIndex;
+        mSosRunning = true;
+        mSosStep = 0;
+        mMainHandler.removeCallbacks(mSosRunnable);
+        mMainHandler.post(mSosRunnable);
+    }
+
+    private void stopSos(boolean restorePrevious) {
+        if (!mSosRunning) return;
+        mSosRunning = false;
+        mMainHandler.removeCallbacks(mSosRunnable);
+        turnOff();
+        if (restorePrevious && mSavedSteadyOn && mSavedLevelIndex >= 0 && mSavedLevelIndex < LEVELS.length) {
+            mSteadyOn = true;
+            mLevelIndex = mSavedLevelIndex;
+            applySteadyLevel(mLevelIndex);
+        } else {
+            mSteadyOn = false;
+            mLevelIndex = -1;
+        }
+    }
+
+    private static void applySteadyLevel(int idx) {
+        if (idx < 0) idx = 0;
+        if (idx >= LEVELS.length) idx = LEVELS.length - 1;
+        writeSysfs(BRIGHT, Integer.toString(LEVELS[idx]));
+        writeSysfs(MODE, Integer.toString(MODE_ON));
+        writeSysfs(MODE, Integer.toString(MODE_ON));
+    }
+
+    private static void turnOff() {
+        writeSysfs(MODE, Integer.toString(MODE_OFF));
+        writeSysfs(BRIGHT, "0");
+    }
+
+    private static void writeSysfs(String path, String v) {
+        try (FileOutputStream fos = new FileOutputStream(path)) {
+            fos.write((v + "\n").getBytes(StandardCharsets.US_ASCII));
+        } catch (Throwable t) {
+            Log.e(TAG, "writeSysfs failed: " + path + " <- " + v, t);
+        }
+    }
+
+    private static int readSysfsInt(String path) {
+        try (FileInputStream fis = new FileInputStream(path)) {
+            byte[] buf = new byte[64];
+            int n = fis.read(buf);
+            if (n <= 0) return 0;
+            String s = new String(buf, 0, n, StandardCharsets.US_ASCII).trim();
+            return Integer.parseInt(s);
+        } catch (Throwable t) {
+            return 0;
+        }
+    }
+}
