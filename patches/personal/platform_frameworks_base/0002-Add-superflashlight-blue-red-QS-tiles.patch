@@ -0,0 +1,116 @@
+package com.android.systemui.qs.tiles;
+
+import android.content.Context;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Log;
+
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+
+final class YftCampLightLeds {
+    private static final String TAG = "YftCampLightLeds";
+    static final String CTL = "/sys/devices/platform/yft_camplight/leds_ctl";
+    static final String POWER_CTRL = "/sys/devices/platform/yft_camplight/power/control";
+    static final String SETTING = "sysui_yft_camplight_leds_mode";
+
+    private static final int MODE_OFF = 0;
+    private static final int MODE_RED = 1;
+    private static final int MODE_BLUE = 2;
+    private static final int MODE_RED_BLUE = 3;
+    private static final int MODE_RED_FLASHY = 4;
+    private static final int MODE_BLUE_FLASHY = 5;
+    private static final int MODE_RED_BLUE_FLASHY = 6;
+
+    static int getMode(Context c) {
+        int mode = Settings.Secure.getIntForUser(
+                c.getContentResolver(), SETTING, MODE_OFF, UserHandle.USER_CURRENT
+        );
+        return mode >= MODE_OFF && mode <= MODE_RED_BLUE_FLASHY ? mode : MODE_OFF;
+    }
+
+    static void setMode(Context c, int mode) {
+        if (mode < MODE_OFF || mode > MODE_RED_BLUE_FLASHY) {
+            mode = MODE_OFF;
+        }
+        Settings.Secure.putIntForUser(
+                c.getContentResolver(), SETTING, mode, UserHandle.USER_CURRENT
+        );
+        applyMode(mode);
+    }
+
+    static void syncHardwareFromSetting(Context c) {
+        applyMode(getMode(c));
+    }
+
+    static boolean isRedOn(Context c) {
+        return (getLightMask(getMode(c)) & MODE_RED) != 0;
+    }
+
+    static boolean isBlueOn(Context c) {
+        return (getLightMask(getMode(c)) & MODE_BLUE) != 0;
+    }
+
+    static boolean isRedFlashy(Context c) {
+        int mode = getMode(c);
+        return mode == MODE_RED_FLASHY || mode == MODE_RED_BLUE_FLASHY;
+    }
+
+    static boolean isBlueFlashy(Context c) {
+        int mode = getMode(c);
+        return mode == MODE_BLUE_FLASHY || mode == MODE_RED_BLUE_FLASHY;
+    }
+
+    static void toggleRed(Context c) {
+        setMode(c, getLightMask(getMode(c)) ^ MODE_RED);
+    }
+
+    static void toggleBlue(Context c) {
+        setMode(c, getLightMask(getMode(c)) ^ MODE_BLUE);
+    }
+
+    static void setRedFlashy(Context c) {
+        int current = getMode(c);
+        setMode(c, (getLightMask(current) & MODE_BLUE) != 0
+                ? MODE_RED_BLUE_FLASHY : MODE_RED_FLASHY);
+    }
+
+    static void setBlueFlashy(Context c) {
+        int current = getMode(c);
+        setMode(c, (getLightMask(current) & MODE_RED) != 0
+                ? MODE_RED_BLUE_FLASHY : MODE_BLUE_FLASHY);
+    }
+
+    private static void applyMode(int mode) {
+        writeString(POWER_CTRL, "on");
+        writeString(CTL, Integer.toString(mode));
+    }
+
+    private static int getLightMask(int mode) {
+        switch (mode) {
+            case MODE_RED:
+            case MODE_RED_FLASHY:
+                return MODE_RED;
+            case MODE_BLUE:
+            case MODE_BLUE_FLASHY:
+                return MODE_BLUE;
+            case MODE_RED_BLUE:
+            case MODE_RED_BLUE_FLASHY:
+                return MODE_RED_BLUE;
+            case MODE_OFF:
+            default:
+                return MODE_OFF;
+        }
+    }
+
+    private static void writeString(String path, String v) {
+        try (FileOutputStream fos = new FileOutputStream(path)) {
+            fos.write(v.getBytes(StandardCharsets.US_ASCII));
+            fos.write('\n');
+        } catch (Throwable t) {
+            Log.e(TAG, "write failed: " + path + " <- " + v, t);
+        }
+    }
+
+    private YftCampLightLeds() {}
+}
