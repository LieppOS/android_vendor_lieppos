diff --git a/packages/SystemUI/src/com/android/systemui/smartpixel/SystemBarsAlphaView.java b/packages/SystemUI/src/com/android/systemui/smartpixel/SystemBarsAlphaView.java
new file mode 100644
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/smartpixel/SystemBarsAlphaView.java
@@ -0,0 +1,125 @@
+package com.android.systemui.smartpixel;
+
+import android.content.Context;
+import android.content.res.Configuration;
+import android.content.res.Resources;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Insets;
+import android.graphics.Paint;
+import android.view.View;
+import android.view.WindowInsets;
+
+import com.android.internal.policy.SystemBarUtils;
+
+/**
+ * Visual fallback for Smart Pixels' system-bars alpha control.
+ *
+ * <p>On Android 16/QPR2 the status/navigation bars may be composed in windows or
+ * surfaces that do not reliably react to child view alpha. This trusted overlay
+ * sits above the bars and draws only over status/navigation-bar insets, making
+ * the alpha percentage visibly affect the system bars regardless of which
+ * SystemUI status-bar implementation is active.</p>
+ */
+public final class SystemBarsAlphaView extends View {
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private int mAlphaPercent;
+
+    public SystemBarsAlphaView(Context context) {
+        super(context);
+        mPaint.setColor(Color.BLACK);
+        setWillNotDraw(false);
+    }
+
+    public void setAlphaPercent(int percent) {
+        int clamped = Math.max(0, Math.min(SmartPixelSettings.MAX_SYSTEM_BARS_ALPHA, percent));
+        if (mAlphaPercent == clamped) return;
+        mAlphaPercent = clamped;
+        mPaint.setAlpha(Math.round(255f * mAlphaPercent / 100f));
+        invalidate();
+    }
+
+    @Override
+    public WindowInsets onApplyWindowInsets(WindowInsets insets) {
+        invalidate();
+        return super.onApplyWindowInsets(insets);
+    }
+
+    @Override
+    protected void onConfigurationChanged(Configuration newConfig) {
+        super.onConfigurationChanged(newConfig);
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (mAlphaPercent <= 0) return;
+
+        final int width = getWidth();
+        final int height = getHeight();
+        if (width <= 0 || height <= 0) return;
+
+        Insets statusInsets = Insets.NONE;
+        Insets navInsets = Insets.NONE;
+        final WindowInsets rootInsets = getRootWindowInsets();
+        if (rootInsets != null) {
+            statusInsets = rootInsets.getInsetsIgnoringVisibility(WindowInsets.Type.statusBars());
+            navInsets = rootInsets.getInsetsIgnoringVisibility(WindowInsets.Type.navigationBars());
+        }
+
+        final int statusTop = Math.max(statusInsets.top, getStatusBarHeight());
+        if (statusTop > 0) {
+            canvas.drawRect(0, 0, width, Math.min(statusTop, height), mPaint);
+        }
+
+        int navLeft = navInsets.left;
+        int navRight = navInsets.right;
+        int navBottom = navInsets.bottom;
+        if (navLeft == 0 && navRight == 0 && navBottom == 0 && shouldFallbackNavigationBar()) {
+            if (getResources().getConfiguration().orientation == Configuration.ORIENTATION_LANDSCAPE) {
+                navRight = getNavigationBarWidth();
+            } else {
+                navBottom = getNavigationBarHeight();
+            }
+        }
+
+        if (navLeft > 0) {
+            canvas.drawRect(0, 0, Math.min(navLeft, width), height, mPaint);
+        }
+        if (navRight > 0) {
+            canvas.drawRect(Math.max(0, width - navRight), 0, width, height, mPaint);
+        }
+        if (navBottom > 0) {
+            canvas.drawRect(0, Math.max(0, height - navBottom), width, height, mPaint);
+        }
+    }
+
+    private int getStatusBarHeight() {
+        try {
+            return SystemBarUtils.getStatusBarHeight(getContext());
+        } catch (Throwable ignored) {
+            return getAndroidDimen("status_bar_height");
+        }
+    }
+
+    private int getNavigationBarHeight() {
+        return getAndroidDimen("navigation_bar_height");
+    }
+
+    private int getNavigationBarWidth() {
+        return getAndroidDimen("navigation_bar_width");
+    }
+
+    private boolean shouldFallbackNavigationBar() {
+        final Resources res = getResources();
+        final int id = res.getIdentifier("config_showNavigationBar", "bool", "android");
+        return id != 0 && res.getBoolean(id);
+    }
+
+    private int getAndroidDimen(String name) {
+        final Resources res = getResources();
+        final int id = res.getIdentifier(name, "dimen", "android");
+        return id != 0 ? res.getDimensionPixelSize(id) : 0;
+    }
+}
