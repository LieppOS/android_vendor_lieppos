@@ -0,0 +1,43 @@
+package com.android.systemui.smartpixel;
+
+import android.content.ContentResolver;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+/** Shared secure-setting keys and helpers for LieppOS Smart Pixels. */
+public final class SmartPixelSettings {
+    public static final String KEY_ENABLED = Settings.Secure.SMART_PIXEL_FILTER_ENABLED;
+    public static final String KEY_PERCENT = Settings.Secure.SMART_PIXEL_FILTER_PERCENT;
+
+    public static final int DEFAULT_PERCENT = 25;
+    public static final int MIN_PERCENT = 10;
+    public static final int MAX_PERCENT = 75;
+
+    private SmartPixelSettings() {}
+
+    public static boolean isEnabled(ContentResolver resolver) {
+        return Settings.Secure.getIntForUser(
+                resolver, KEY_ENABLED, 0, UserHandle.USER_CURRENT) == 1;
+    }
+
+    public static void setEnabled(ContentResolver resolver, boolean enabled) {
+        Settings.Secure.putIntForUser(
+                resolver, KEY_ENABLED, enabled ? 1 : 0, UserHandle.USER_CURRENT);
+    }
+
+    public static int getPercent(ContentResolver resolver) {
+        return clampPercent(Settings.Secure.getIntForUser(
+                resolver, KEY_PERCENT, DEFAULT_PERCENT, UserHandle.USER_CURRENT));
+    }
+
+    public static void setPercent(ContentResolver resolver, int percent) {
+        Settings.Secure.putIntForUser(
+                resolver, KEY_PERCENT, clampPercent(percent), UserHandle.USER_CURRENT);
+    }
+
+    public static int clampPercent(int percent) {
+        if (percent < MIN_PERCENT) return MIN_PERCENT;
+        if (percent > MAX_PERCENT) return MAX_PERCENT;
+        return percent;
+    }
+}
