--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/AdbUsbSupport.java
@@ -0,0 +1,46 @@
+package com.android.systemui.qs.tiles;
+
+import android.content.Context;
+import android.hardware.usb.UsbManager;
+import android.provider.Settings;
+import android.util.Log;
+
+final class AdbUsbSupport {
+    private static final String TAG = "AdbUsbSupport";
+
+    private AdbUsbSupport() {}
+
+    static boolean isAdbEnabled(Context context) {
+        return Settings.Global.getInt(
+                context.getContentResolver(), Settings.Global.ADB_ENABLED, 0) != 0;
+    }
+
+    static void setAdbEnabled(Context context, boolean enabled) {
+        // Only flip Settings.Global.ADB_ENABLED, exactly like the Developer
+        // Options switch. AdbService observes this and drives the full chain:
+        // mDebuggingManager -> UsbDeviceManager.AdbTransport.onAdbEnabled ->
+        // sets persist.sys.usb.config=mtp,adb AND re-enumerates the gadget with
+        // FUNCTION_ADB. Do NOT poke USB functions here: an extra
+        // setCurrentFunctions() races that rebuild on configfs and could tear
+        // down g1/configs/c.1 mid-teardown, leaving the UDC unbound
+        // (sys.usb.state=none) and ADB permanently dead until reboot.
+        Settings.Global.putInt(
+                context.getContentResolver(), Settings.Global.ADB_ENABLED, enabled ? 1 : 0);
+    }
+
+    static void setCurrentFunctions(Context context, long functions) {
+        UsbManager usbManager = context.getSystemService(UsbManager.class);
+        if (usbManager == null) {
+            return;
+        }
+        try {
+            // Never pass FUNCTION_ADB to setCurrentFunctions: it is not in
+            // SETTABLE_FUNCTIONS and the call requires a single settable bit, so
+            // mtp|adb throws IllegalArgumentException. UsbDeviceManager re-adds
+            // FUNCTION_ADB itself when ADB is enabled.
+            usbManager.setCurrentFunctions(functions & ~UsbManager.FUNCTION_ADB);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Unable to update USB functions", e);
+        }
+    }
+}
