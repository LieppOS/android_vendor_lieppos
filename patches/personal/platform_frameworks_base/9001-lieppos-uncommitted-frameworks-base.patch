+ */
+package com.android.server.display;
+
+import android.content.BroadcastReceiver;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.hardware.display.DisplayManager;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.ServiceManager;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Slog;
+import android.view.Display;
+import android.view.SurfaceControl;
+
+import com.android.server.SystemService;
+
+public class SmoothDisplayService extends SystemService {
+
+    private static final String TAG = "SmoothDisplayService";
+    private static volatile SmoothDisplayService sInstance;
+
+    private static final String PEAK = Settings.System.PEAK_REFRESH_RATE;
+    private static final String MIN  = Settings.System.MIN_REFRESH_RATE;
+
+    private static final int DEFAULT_TIMEOUT_SEC = 5;
+    private static final int DEFAULT_IDLE_HZ = 60;
+
+    private static final int SF_BACKDOOR_SET_ACTIVE_MODE = 1035;
+    private static final String SURFACE_COMPOSER_DESCRIPTOR = "android.ui.ISurfaceComposer";
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private DisplayManager mDm;
+    private long mPhysicalDisplayId = -1;
+    private IBinder mDisplayToken;
+
+    private boolean mEnabled;
+    private int mPeakHz;
+    private int mIdleHz;
+    private int mTimeoutSec;
+
+    private int mPanelMinHz = 60;
+    private int mPanelMaxHz = 60;
+
+    private boolean mIdleActive = false;
+    private boolean mScreenOn = true;
+
+    public SmoothDisplayService(Context context) {
+        super(context);
+        mContext = context;
+        mHandler = new Handler(Looper.getMainLooper());
+        sInstance = this;
+    }
+
+    public static void notifyUserActivity() {
+        SmoothDisplayService service = sInstance;
+        if (service != null) {
+            service.mHandler.post(service::onActivity);
+        }
+    }
+
+    @Override
+    public void onStart() {}
+
+    @Override
+    public void onBootPhase(int phase) {
+        if (phase != PHASE_BOOT_COMPLETED) return;
+
+        mDm = mContext.getSystemService(DisplayManager.class);
+        detectPanelRange();
+        detectPhysicalDisplay();
+
+        ContentResolver cr = mContext.getContentResolver();
+        ContentObserver obs = new ContentObserver(mHandler) {
+            @Override public void onChange(boolean self, Uri uri) { reload(); }
+        };
+        cr.registerContentObserver(Settings.Secure.getUriFor(
+                Settings.Secure.LIEPPOS_SMOOTH_DISPLAY_ENABLED), false, obs, UserHandle.USER_ALL);
+        cr.registerContentObserver(Settings.Secure.getUriFor(
+                Settings.Secure.LIEPPOS_SMOOTH_PEAK_HZ), false, obs, UserHandle.USER_ALL);
+        cr.registerContentObserver(Settings.Secure.getUriFor(
+                Settings.Secure.LIEPPOS_SMOOTH_IDLE_HZ), false, obs, UserHandle.USER_ALL);
+        cr.registerContentObserver(Settings.Secure.getUriFor(
+                Settings.Secure.LIEPPOS_SMOOTH_IDLE_TIMEOUT_SEC), false, obs, UserHandle.USER_ALL);
+
+        IntentFilter f = new IntentFilter();
+        f.addAction(Intent.ACTION_SCREEN_ON);
+        f.addAction(Intent.ACTION_SCREEN_OFF);
+        f.addAction(Intent.ACTION_USER_PRESENT);
+        mContext.registerReceiver(mScreenReceiver, f);
+
+        reload();
+    }
+
+    private void detectPanelRange() {
+        try {
+            Display d = mDm.getDisplay(Display.DEFAULT_DISPLAY);
+            if (d == null) return;
+            Display.Mode[] modes = d.getSupportedModes();
+            int lo = Integer.MAX_VALUE, hi = 0;
+            for (Display.Mode m : modes) {
+                int hz = Math.round(m.getRefreshRate());
+                if (hz < lo) lo = hz;
+                if (hz > hi) hi = hz;
+            }
+            if (lo != Integer.MAX_VALUE) mPanelMinHz = lo;
+            if (hi > 0) mPanelMaxHz = hi;
+        } catch (Throwable t) {
+            Slog.w(TAG, "detectPanelRange failed", t);
+        }
+    }
+
+    private void detectPhysicalDisplay() {
+        try {
+            long[] ids = DisplayControl.getPhysicalDisplayIds();
+            if (ids.length == 0) return;
+            mPhysicalDisplayId = ids[0];
+            mDisplayToken = DisplayControl.getPhysicalDisplayToken(mPhysicalDisplayId);
+        } catch (Throwable t) {
+            Slog.w(TAG, "detectPhysicalDisplay failed", t);
+        }
+    }
+
+    private final BroadcastReceiver mScreenReceiver = new BroadcastReceiver() {
+        @Override public void onReceive(Context c, Intent i) {
+            String a = i.getAction();
+            if (Intent.ACTION_SCREEN_ON.equals(a) || Intent.ACTION_USER_PRESENT.equals(a)) {
+                mScreenOn = true;
+                onActivity();
+            } else if (Intent.ACTION_SCREEN_OFF.equals(a)) {
+                mScreenOn = false;
+                mHandler.removeCallbacks(mIdleRunnable);
+                applyActiveRefresh();
+            }
+        }
+    };
+
+    private void reload() {
+        ContentResolver cr = mContext.getContentResolver();
+        mEnabled = Settings.Secure.getIntForUser(cr,
+                Settings.Secure.LIEPPOS_SMOOTH_DISPLAY_ENABLED, 0, UserHandle.USER_CURRENT) == 1;
+        mPeakHz = Settings.Secure.getIntForUser(cr,
+                Settings.Secure.LIEPPOS_SMOOTH_PEAK_HZ, mPanelMaxHz, UserHandle.USER_CURRENT);
+        mIdleHz = Settings.Secure.getIntForUser(cr,
+                Settings.Secure.LIEPPOS_SMOOTH_IDLE_HZ, DEFAULT_IDLE_HZ, UserHandle.USER_CURRENT);
+        mTimeoutSec = Settings.Secure.getIntForUser(cr,
+                Settings.Secure.LIEPPOS_SMOOTH_IDLE_TIMEOUT_SEC,
+                DEFAULT_TIMEOUT_SEC, UserHandle.USER_CURRENT);
+
+        mPeakHz = clampHz(mPeakHz);
+        mIdleHz = clampHz(mIdleHz);
+        if (mIdleHz > mPeakHz) mIdleHz = mPeakHz;
+
+        if (mEnabled) {
+            onActivity();
+        } else {
+            mHandler.removeCallbacks(mIdleRunnable);
+            mIdleActive = false;
+            Settings.System.putFloatForUser(cr, PEAK, 0f, UserHandle.USER_CURRENT);
+            Settings.System.putFloatForUser(cr, MIN, 0f, UserHandle.USER_CURRENT);
+            applySurfaceFlingerMode(mPanelMaxHz, 0, mPanelMaxHz);
+        }
+    }
+
+    private int clampHz(int hz) {
+        if (hz < mPanelMinHz) hz = mPanelMinHz;
+        if (hz > mPanelMaxHz) hz = mPanelMaxHz;
+        return hz;
+    }
+
+    private void onActivity() {
+        if (!mEnabled || !mScreenOn) return;
+        applyActiveRefresh();
+        mIdleActive = false;
+        mHandler.removeCallbacks(mIdleRunnable);
+        mHandler.postDelayed(mIdleRunnable, mTimeoutSec * 1000L);
+    }
+
+    private final Runnable mIdleRunnable = new Runnable() {
+        @Override public void run() {
+            if (!mEnabled || !mScreenOn) return;
+            mIdleActive = true;
+            applyIdleRefresh();
+        }
+    };
+
+    private void applyActiveRefresh() {
+        ContentResolver cr = mContext.getContentResolver();
+        Settings.System.putFloatForUser(cr, PEAK, (float) mPeakHz, UserHandle.USER_CURRENT);
+        Settings.System.putFloatForUser(cr, MIN, (float) mIdleHz, UserHandle.USER_CURRENT);
+        applySurfaceFlingerMode(mPeakHz, mIdleHz, mPeakHz);
+    }
+
+    private void applyIdleRefresh() {
+        ContentResolver cr = mContext.getContentResolver();
+        Settings.System.putFloatForUser(cr, PEAK, (float) mIdleHz, UserHandle.USER_CURRENT);
+        Settings.System.putFloatForUser(cr, MIN, (float) mIdleHz, UserHandle.USER_CURRENT);
+        applySurfaceFlingerMode(mIdleHz, mIdleHz, mIdleHz);
+    }
+
+    private void applySurfaceFlingerMode(int defaultHz, int minHz, int maxHz) {
+        if (mDisplayToken == null || mPhysicalDisplayId < 0) {
+            detectPhysicalDisplay();
+        }
+        if (mDisplayToken == null || mPhysicalDisplayId < 0) return;
+
+        try {
+            SurfaceControl.DynamicDisplayInfo info =
+                    SurfaceControl.getDynamicDisplayInfo(mPhysicalDisplayId);
+            if (info == null || info.supportedDisplayModes == null) return;
+
+            int sfModeId = findClosestSfModeId(info, defaultHz);
+            if (sfModeId < 0) return;
+
+            SurfaceControl.RefreshRateRange primary =
+                    new SurfaceControl.RefreshRateRange(minHz, maxHz);
+            SurfaceControl.RefreshRateRanges ranges = new SurfaceControl.RefreshRateRanges(
+                    primary, primary);
+            SurfaceControl.DesiredDisplayModeSpecs specs =
+                    new SurfaceControl.DesiredDisplayModeSpecs(sfModeId, false,
+                            ranges, ranges, null);
+            boolean ok = SurfaceControl.setDesiredDisplayModeSpecs(mDisplayToken, specs);
+            boolean backdoorOk = applySurfaceFlingerBackdoorMode(sfModeId, minHz, maxHz);
+            Slog.d(TAG, "applySurfaceFlingerMode hz=" + defaultHz + " range=" + minHz
+                    + "-" + maxHz + " sfModeId=" + sfModeId + " ok=" + ok
+                    + " backdoorOk=" + backdoorOk);
+        } catch (Throwable t) {
+            Slog.w(TAG, "applySurfaceFlingerMode failed", t);
+        }
+    }
+
+    private boolean applySurfaceFlingerBackdoorMode(int sfModeId, int minHz, int maxHz) {
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            IBinder sf = ServiceManager.getService("SurfaceFlinger");
+            if (sf == null) return false;
+            data.writeInterfaceToken(SURFACE_COMPOSER_DESCRIPTOR);
+            data.writeInt(sfModeId);
+            data.writeLong(mPhysicalDisplayId);
+            data.writeFloat((float) minHz);
+            data.writeFloat((float) maxHz);
+            return sf.transact(SF_BACKDOOR_SET_ACTIVE_MODE, data, reply, 0);
+        } catch (Throwable t) {
+            Slog.w(TAG, "applySurfaceFlingerBackdoorMode failed", t);
+            return false;
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+
+    private int findClosestSfModeId(SurfaceControl.DynamicDisplayInfo info, int targetHz) {
+        int bestId = -1;
+        float bestDelta = Float.MAX_VALUE;
+        for (SurfaceControl.DisplayMode mode : info.supportedDisplayModes) {
+            float hz = mode.peakRefreshRate > 0 ? mode.peakRefreshRate : mode.vsyncRate;
+            float delta = Math.abs(hz - targetHz);
+            if (delta < bestDelta) {
+                bestDelta = delta;
+                bestId = mode.id;
+            }
+        }
+        return bestId;
+    }
+}
