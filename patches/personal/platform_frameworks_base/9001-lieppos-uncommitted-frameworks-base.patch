diff --git a/services/core/java/com/android/server/display/SmoothDisplayService.java b/services/core/java/com/android/server/display/SmoothDisplayService.java
new file mode 100644
index 000000000000..69624b85fb74
--- /dev/null
+++ b/services/core/java/com/android/server/display/SmoothDisplayService.java
@@ -0,0 +1,279 @@
+/*
