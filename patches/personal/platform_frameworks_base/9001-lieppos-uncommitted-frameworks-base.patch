diff --git a/packages/SystemUI/src/com/android/systemui/qs/tiles/UsbModeTile.java b/packages/SystemUI/src/com/android/systemui/qs/tiles/UsbModeTile.java
new file mode 100644
index 000000000000..94718032e094
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/UsbModeTile.java
@@ -0,0 +1,174 @@
+package com.android.systemui.qs.tiles;
+
+import android.content.ComponentName;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.hardware.usb.UsbManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.service.quicksettings.Tile;
+import android.widget.Switch;
+
+import androidx.annotation.Nullable;
+
+import com.android.internal.logging.MetricsLogger;
+import com.android.systemui.animation.Expandable;
+import com.android.systemui.dagger.qualifiers.Background;
+import com.android.systemui.dagger.qualifiers.Main;
+import com.android.systemui.plugins.ActivityStarter;
+import com.android.systemui.plugins.FalsingManager;
+import com.android.systemui.plugins.qs.QSTile.BooleanState;
+import com.android.systemui.plugins.statusbar.StatusBarStateController;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.QsEventLogger;
+import com.android.systemui.qs.logging.QSLogger;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+import com.android.systemui.res.R;
+
+import javax.inject.Inject;
+
+public class UsbModeTile extends QSTileImpl<BooleanState> {
+    public static final String TILE_SPEC = "usb_mode";
+
+    private static final long[] FUNCTIONS = new long[] {
+            UsbManager.FUNCTION_NONE,
+            UsbManager.FUNCTION_MTP,
+            UsbManager.FUNCTION_PTP,
+            UsbManager.FUNCTION_RNDIS,
+            UsbManager.FUNCTION_MIDI,
+    };
+
+    private final UsbManager mUsbManager;
+    private boolean mListening;
+    private boolean mUsbConnected;
+
+    @Inject
+    public UsbModeTile(
+            QSHost host,
+            QsEventLogger uiEventLogger,
+            @Background Looper backgroundLooper,
+            @Main Handler mainHandler,
+            FalsingManager falsingManager,
+            MetricsLogger metricsLogger,
+            StatusBarStateController statusBarStateController,
+            ActivityStarter activityStarter,
+            QSLogger qsLogger
+    ) {
+        super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager,
+                metricsLogger, statusBarStateController, activityStarter, qsLogger);
+        mUsbManager = mContext.getSystemService(UsbManager.class);
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_usb_mode_label);
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return new Intent().setComponent(new ComponentName(
+                "com.android.settings", "com.android.settings.Settings$UsbDetailsActivity"));
+    }
+
+    @Override
+    protected void handleClick(@Nullable Expandable expandable) {
+        if (!mUsbConnected || mUsbManager == null) {
+            refreshState();
+            return;
+        }
+        AdbUsbSupport.setCurrentFunctions(mContext, getNextFunction(getCurrentFunction()));
+        refreshState();
+    }
+
+    @Override
+    protected void handleSetListening(boolean listening) {
+        super.handleSetListening(listening);
+        if (mListening == listening) {
+            return;
+        }
+        mListening = listening;
+        if (listening) {
+            IntentFilter filter = new IntentFilter(UsbManager.ACTION_USB_STATE);
+            Intent intent = mContext.registerReceiver(mReceiver, filter);
+            if (intent != null) {
+                updateUsbState(intent);
+            }
+        } else {
+            mContext.unregisterReceiver(mReceiver);
+        }
+    }
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            updateUsbState(intent);
+            refreshState();
+        }
+    };
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        long function = getCurrentFunction();
+        state.value = mUsbConnected && function != UsbManager.FUNCTION_NONE;
+        state.label = getTileLabel();
+        state.icon = maybeLoadResourceIcon(R.drawable.qs_usb_mode_icon);
+        state.secondaryLabel = getFunctionLabel(function);
+        state.state = !mUsbConnected ? Tile.STATE_UNAVAILABLE
+                : state.value ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+        state.contentDescription = state.label;
+        state.expandedAccessibilityClassName = Switch.class.getName();
+    }
+
+    @Override
+    public BooleanState newTileState() {
+        return new BooleanState();
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return 0;
+    }
+
+    private void updateUsbState(Intent intent) {
+        mUsbConnected = intent.getBooleanExtra(UsbManager.USB_CONNECTED, false);
+    }
+
+    private long getCurrentFunction() {
+        return mUsbManager == null ? UsbManager.FUNCTION_NONE : mUsbManager.getCurrentFunctions();
+    }
+
+    private long getNextFunction(long currentFunction) {
+        long normalized = normalizeFunction(currentFunction);
+        for (int i = 0; i < FUNCTIONS.length; i++) {
+            if (FUNCTIONS[i] == normalized) {
+                return FUNCTIONS[(i + 1) % FUNCTIONS.length];
+            }
+        }
+        return UsbManager.FUNCTION_NONE;
+    }
+
+    private long normalizeFunction(long function) {
+        for (long candidate : FUNCTIONS) {
+            if ((function & candidate) != 0 || function == candidate) {
+                return candidate;
+            }
+        }
+        return UsbManager.FUNCTION_NONE;
+    }
+
+    private CharSequence getFunctionLabel(long function) {
+        long normalized = normalizeFunction(function);
+        if (normalized == UsbManager.FUNCTION_MTP) {
+            return mContext.getString(R.string.quick_settings_usb_mode_mtp);
+        } else if (normalized == UsbManager.FUNCTION_PTP) {
+            return mContext.getString(R.string.quick_settings_usb_mode_ptp);
+        } else if (normalized == UsbManager.FUNCTION_RNDIS) {
+            return mContext.getString(R.string.quick_settings_usb_mode_tethering);
+        } else if (normalized == UsbManager.FUNCTION_MIDI) {
+            return mContext.getString(R.string.quick_settings_usb_mode_midi);
+        }
+        return mContext.getString(R.string.quick_settings_usb_mode_charging);
+    }
+}
