+ *      http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+package com.android.server.policy;
+
+import android.content.Context;
+import android.os.SystemProperties;
+import android.util.DisplayMetrics;
+import android.view.MotionEvent;
+import android.view.WindowManagerPolicyConstants.PointerEventListener;
+
+public class SwipeToScreenshotListener implements PointerEventListener {
+    private static final int STATE_NONE = 0;
+    private static final int STATE_DETECTING = 1;
+    private static final int STATE_DETECTED_FALSE = 2;
+    private static final int STATE_DETECTED_TRUE = 3;
+    private static final int STATE_NO_DETECT = 4;
+
+    private boolean mBootCompleted;
+    private final Context mContext;
+    private final float[] mInitMotionY = new float[3];
+    private final int[] mPointerIds = new int[3];
+    private int mState = STATE_NONE;
+    private final int mThreshold;
+    private final int mTripleThreshold;
+    private final Callbacks mCallbacks;
+    private final DisplayMetrics mDisplayMetrics;
+
+    public SwipeToScreenshotListener(Context context, Callbacks callbacks) {
+        mContext = context;
+        mCallbacks = callbacks;
+        mDisplayMetrics = mContext.getResources().getDisplayMetrics();
+        mThreshold = (int) (50.0f * mDisplayMetrics.density);
+        mTripleThreshold = mThreshold * 3;
+    }
+
+    @Override
+    public void onPointerEvent(MotionEvent event) {
+        if (!mBootCompleted) {
+            mBootCompleted = SystemProperties.getBoolean("sys.boot_completed", false);
+            return;
+        }
+        if (event.getAction() == MotionEvent.ACTION_DOWN) {
+            mState = STATE_NONE;
+        } else if (mState == STATE_NONE && event.getPointerCount() == 3) {
+            if (checkStartGesture(event)) {
+                mState = STATE_DETECTING;
+                for (int i = 0; i < 3; i++) {
+                    mPointerIds[i] = event.getPointerId(i);
+                    mInitMotionY[i] = event.getY(i);
+                }
+            } else {
+                mState = STATE_NO_DETECT;
+            }
+        }
+        if (mState == STATE_DETECTING) {
+            if (event.getPointerCount() != 3) {
+                mState = STATE_DETECTED_FALSE;
+                return;
+            }
+            if (event.getActionMasked() == MotionEvent.ACTION_MOVE) {
+                float distance = 0f;
+                for (int i = 0; i < 3; i++) {
+                    int idx = event.findPointerIndex(mPointerIds[i]);
+                    if (idx < 0 || idx >= 3) {
+                        mState = STATE_DETECTED_FALSE;
+                        return;
+                    }
+                    distance += event.getY(idx) - mInitMotionY[i];
+                }
+                if (distance >= mTripleThreshold) {
+                    mState = STATE_DETECTED_TRUE;
+                    mCallbacks.onSwipeThreeFinger();
+                }
+            }
+        }
+    }
+
+    private boolean checkStartGesture(MotionEvent event) {
+        if (event.getEventTime() - event.getDownTime() > 500) {
+            return false;
+        }
+        int height = mDisplayMetrics.heightPixels;
+        int width = mDisplayMetrics.widthPixels;
+        float minX = Float.MAX_VALUE, maxX = Float.MIN_VALUE;
+        float minY = Float.MAX_VALUE, maxY = Float.MIN_VALUE;
+        for (int i = 0; i < event.getPointerCount(); i++) {
+            float x = event.getX(i);
+            float y = event.getY(i);
+            if (y > (height - mThreshold)) return false;
+            maxX = Math.max(maxX, x);
+            minX = Math.min(minX, x);
+            maxY = Math.max(maxY, y);
+            minY = Math.min(minY, y);
+        }
+        if (maxY - minY <= mDisplayMetrics.density * 150.0f) {
+            return maxX - minX <= Math.min(width, height);
+        }
+        return false;
+    }
+
+    interface Callbacks {
+        void onSwipeThreeFinger();
+    }
+}
