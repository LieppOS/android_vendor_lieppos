+package com.android.server.power;
+
+import static android.provider.Settings.Global.ZEN_MODE_IMPORTANT_INTERRUPTIONS;
+import static android.provider.Settings.Global.ZEN_MODE_OFF;
+
+import android.annotation.Nullable;
+import android.app.ActivityManager;
+import android.app.AlarmManager;
+import android.app.Notification;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.bluetooth.BluetoothAdapter;
+import android.content.BroadcastReceiver;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.hardware.SensorPrivacyManager;
+import android.media.AudioManager;
+import android.net.Uri;
+import android.net.wifi.WifiManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+import android.util.Slog;
+import android.widget.Toast;
+
+import com.android.internal.R;
+import com.android.internal.notification.SystemNotificationChannels;
+import com.android.server.SystemService;
+import com.android.server.twilight.TwilightListener;
+import com.android.server.twilight.TwilightManager;
+import com.android.server.twilight.TwilightState;
+
+import java.util.Calendar;
+
+/**
+ * Schedules and applies LieppOS Sleep mode.
+ */
+public class SleepModeService extends SystemService {
+
+    private static final String TAG = "SleepModeService";
+
+    private static final int MODE_DISABLED = 0;
+    private static final int MODE_NIGHT = 1;
+    private static final int MODE_TIME = 2;
+    private static final int MODE_MIXED_SUNSET = 3;
+    private static final int MODE_MIXED_SUNRISE = 4;
+
+    private final Context mContext;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final AlarmManager mAlarmManager;
+    private final SleepModeController mController;
+    private final SettingsObserver mSettingsObserver;
+
+    private TwilightManager mTwilightManager;
+    private TwilightState mTwilightState;
+
+    private int mMode = MODE_DISABLED;
+    private boolean mActive;
+    private boolean mIsNextActivate;
+    private boolean mTimeReceiverRegistered;
+    private boolean mTwilightListenerRegistered;
+
+    private final TwilightListener mTwilightListener = new TwilightListener() {
+        @Override
+        public void onTwilightStateChanged(@Nullable TwilightState state) {
+            if (mMode != MODE_NIGHT && mMode < MODE_MIXED_SUNSET) {
+                setTwilightListener(false);
+                return;
+            }
+            if (state == null) return;
+            mTwilightState = state;
+            mHandler.post(() -> maybeActivateSleepMode());
+        }
+    };
+
+    private final BroadcastReceiver mTimeChangedReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (mMode != MODE_TIME && mMode < MODE_MIXED_SUNSET) {
+                setTimeReceiver(false);
+                return;
+            }
+            mHandler.post(() -> maybeActivateSleepMode());
+        }
+    };
+
+    private final AlarmManager.OnAlarmListener mAlarmListener = () -> {
+        mHandler.post(() -> setAutoSleepModeActive(mIsNextActivate));
+        mHandler.post(() -> maybeActivateSleepMode(false));
+    };
+
+    public SleepModeService(Context context) {
+        super(context);
+        mContext = context;
+        mAlarmManager = mContext.getSystemService(AlarmManager.class);
+        mController = new SleepModeController(mContext);
+        mSettingsObserver = new SettingsObserver(mHandler);
+    }
+
+    @Override
+    public void onStart() {
+        Slog.v(TAG, "Starting " + TAG);
+        publishLocalService(SleepModeService.class, this);
+        mSettingsObserver.observe();
+        mController.observe();
+    }
+
+    @Override
+    public void onBootPhase(int phase) {
+        if (phase == SystemService.PHASE_SYSTEM_SERVICES_READY) {
+            mTwilightManager = getLocalService(TwilightManager.class);
+        } else if (phase == SystemService.PHASE_BOOT_COMPLETED) {
+            mHandler.post(() -> {
+                mController.update();
+                initState();
+            });
+        }
+    }
+
+    private void initState() {
+        final int previousMode = mMode;
+        mMode = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                Settings.Secure.SLEEP_MODE_AUTO_MODE, MODE_DISABLED, UserHandle.USER_CURRENT);
+        cancelAlarm();
+
+        switch (mMode) {
+            case MODE_TIME:
+                setTimeReceiver(true);
+                setTwilightListener(false);
+                break;
+            case MODE_NIGHT:
+                setTimeReceiver(false);
+                setTwilightListener(true);
+                break;
+            case MODE_MIXED_SUNSET:
+            case MODE_MIXED_SUNRISE:
+                setTimeReceiver(true);
+                setTwilightListener(true);
+                break;
+            case MODE_DISABLED:
+            default:
+                setTimeReceiver(false);
+                setTwilightListener(false);
+                if (previousMode != MODE_DISABLED) {
+                    setAutoSleepModeActive(false);
+                }
+                return;
+        }
+
+        maybeActivateSleepMode();
+    }
+
+    private void setTimeReceiver(boolean register) {
+        if (register == mTimeReceiverRegistered) return;
+        if (register) {
+            final IntentFilter filter = new IntentFilter(Intent.ACTION_TIME_CHANGED);
+            filter.addAction(Intent.ACTION_TIMEZONE_CHANGED);
+            mContext.registerReceiver(mTimeChangedReceiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        } else {
+            try {
+                mContext.unregisterReceiver(mTimeChangedReceiver);
+            } catch (IllegalArgumentException ignored) {
+            }
+        }
+        mTimeReceiverRegistered = register;
+    }
+
+    private void setTwilightListener(boolean register) {
+        if (register == mTwilightListenerRegistered || mTwilightManager == null) return;
+        if (register) {
+            mTwilightManager.registerListener(mTwilightListener, mHandler);
+            mTwilightState = mTwilightManager.getLastTwilightState();
+        } else {
+            mTwilightManager.unregisterListener(mTwilightListener);
+            mTwilightState = null;
+        }
+        mTwilightListenerRegistered = register;
+    }
+
+    private void maybeActivateSleepMode() {
+        maybeActivateSleepMode(true);
+    }
+
+    private void maybeActivateSleepMode(boolean setActive) {
+        switch (mMode) {
+            case MODE_NIGHT:
+                maybeActivateNight(setActive);
+                break;
+            case MODE_TIME:
+            case MODE_MIXED_SUNSET:
+            case MODE_MIXED_SUNRISE:
+                maybeActivateTime(setActive);
+                break;
+            case MODE_DISABLED:
+            default:
+                break;
+        }
+    }
+
+    private void maybeActivateNight(boolean setActive) {
+        if (mTwilightState == null) {
+            Slog.w(TAG, "No twilight state, cannot schedule night Sleep mode");
+            return;
+        }
+        mIsNextActivate = !mTwilightState.isNight();
+        setAlarm(mIsNextActivate ? mTwilightState.sunsetTimeMillis()
+                : mTwilightState.sunriseTimeMillis());
+        if (setActive) {
+            setAutoSleepModeActive(!mIsNextActivate);
+        }
+    }
+
+    private void maybeActivateTime(boolean setActive) {
+        final Calendar current = Calendar.getInstance();
+        final Calendar since = Calendar.getInstance();
+        final Calendar till = Calendar.getInstance();
+        final String[] times = getCustomTimes();
+        final String[] sinceValues = times[0].split(":", 0);
+        final String[] tillValues = times[1].split(":", 0);
+
+        since.set(Calendar.HOUR_OF_DAY, Integer.parseInt(sinceValues[0]));
+        since.set(Calendar.MINUTE, Integer.parseInt(sinceValues[1]));
+        since.set(Calendar.SECOND, 0);
+        till.set(Calendar.HOUR_OF_DAY, Integer.parseInt(tillValues[0]));
+        till.set(Calendar.MINUTE, Integer.parseInt(tillValues[1]));
+        till.set(Calendar.SECOND, 0);
+
+        if (mMode >= MODE_MIXED_SUNSET) {
+            if (mTwilightState == null) {
+                Slog.w(TAG, "No twilight state, cannot schedule mixed Sleep mode");
+                return;
+            }
+            if (mMode == MODE_MIXED_SUNSET) {
+                since.setTimeInMillis(mTwilightState.sunsetTimeMillis());
+            } else {
+                till.setTimeInMillis(mTwilightState.sunriseTimeMillis());
+                if (!mTwilightState.isNight()) {
+                    till.add(Calendar.DATE, 1);
+                }
+            }
+        }
+
+        if (current.before(since) && current.before(till) && till.compareTo(since) < 0) {
+            since.add(Calendar.DATE, -1);
+        }
+        if (since.after(till)) {
+            till.add(Calendar.DATE, 1);
+        }
+        if (current.after(since) && current.compareTo(till) >= 0) {
+            since.add(Calendar.DATE, 1);
+            till.add(Calendar.DATE, 1);
+        }
+        if (since.compareTo(till) == 0) {
+            Slog.w(TAG, "Ignoring zero-length Sleep mode schedule");
+            return;
+        }
+
+        mIsNextActivate = current.before(since);
+        setAlarm(mIsNextActivate ? since.getTimeInMillis() : till.getTimeInMillis());
+        if (setActive) {
+            setAutoSleepModeActive(current.compareTo(since) >= 0 && current.before(till));
+        }
+    }
+
+    private String[] getCustomTimes() {
+        String value = Settings.Secure.getStringForUser(mContext.getContentResolver(),
+                Settings.Secure.SLEEP_MODE_AUTO_TIME, UserHandle.USER_CURRENT);
+        if (value == null || !value.matches(
+                "([01][0-9]|2[0-3]):[0-5][0-9],([01][0-9]|2[0-3]):[0-5][0-9]")) {
+            value = "22:00,07:00";
+        }
+        return value.split(",", 0);
+    }
+
+    private void setAlarm(long timeMillis) {
+        cancelAlarm();
+        if (mAlarmManager != null) {
+            mAlarmManager.setExact(AlarmManager.RTC_WAKEUP, timeMillis, TAG, mAlarmListener,
+                    mHandler);
+        }
+    }
+
+    private void cancelAlarm() {
+        if (mAlarmManager != null) {
+            mAlarmManager.cancel(mAlarmListener);
+        }
+    }
+
+    private void setAutoSleepModeActive(boolean active) {
+        if (mActive == active) return;
+        mActive = active;
+        Settings.Secure.putIntForUser(mContext.getContentResolver(),
+                Settings.Secure.SLEEP_MODE_ENABLED, active ? 1 : 0, UserHandle.USER_CURRENT);
+    }
+
+    private final class SettingsObserver extends ContentObserver {
+        SettingsObserver(Handler handler) {
+            super(handler);
+        }
+
+        void observe() {
+            final ContentResolver resolver = mContext.getContentResolver();
+            resolver.registerContentObserver(Settings.Secure.getUriFor(
+                    Settings.Secure.SLEEP_MODE_AUTO_MODE), false, this, UserHandle.USER_ALL);
+            resolver.registerContentObserver(Settings.Secure.getUriFor(
+                    Settings.Secure.SLEEP_MODE_AUTO_TIME), false, this, UserHandle.USER_ALL);
+        }
+
+        @Override
+        public void onChange(boolean selfChange, Uri uri) {
+            mHandler.post(() -> initState());
+        }
+    }
+
+    private static final class SleepModeController {
+        private static final int SLEEP_NOTIFICATION_ID = 727;
+        private static final String ACTION_TURN_OFF =
+                "com.android.server.power.action.TURN_OFF_SLEEP_MODE";
+
+        private final Context mContext;
+        private final Handler mHandler = new Handler(Looper.getMainLooper());
+        private final AudioManager mAudioManager;
+        private final NotificationManager mNotificationManager;
+        private final WifiManager mWifiManager;
+        private final SensorPrivacyManager mSensorPrivacyManager;
+        private final BluetoothAdapter mBluetoothAdapter;
+
+        private boolean mSleepModeEnabled;
+        private boolean mWifiState;
+        private boolean mCellularState;
+        private boolean mBluetoothState;
+        private int mRingerState;
+        private int mZenState;
+
+        private final BroadcastReceiver mTurnOffReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                if (ACTION_TURN_OFF.equals(intent.getAction())) {
+                    Settings.Secure.putIntForUser(mContext.getContentResolver(),
+                            Settings.Secure.SLEEP_MODE_ENABLED, 0, UserHandle.USER_CURRENT);
+                }
+            }
+        };
+
+        private final ContentObserver mSettingsObserver = new ContentObserver(mHandler) {
+            @Override
+            public void onChange(boolean selfChange, Uri uri) {
+                update();
+            }
+        };
+
+        SleepModeController(Context context) {
+            mContext = context;
+            mAudioManager = mContext.getSystemService(AudioManager.class);
+            mNotificationManager = mContext.getSystemService(NotificationManager.class);
+            mWifiManager = mContext.getSystemService(WifiManager.class);
+            mSensorPrivacyManager = mContext.getSystemService(SensorPrivacyManager.class);
+            mBluetoothAdapter = BluetoothAdapter.getDefaultAdapter();
+            mSleepModeEnabled = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                    Settings.Secure.SLEEP_MODE_ENABLED, 0, UserHandle.USER_CURRENT) == 1;
+        }
+
+        void observe() {
+            final IntentFilter filter = new IntentFilter(ACTION_TURN_OFF);
+            mContext.registerReceiver(mTurnOffReceiver, filter, Context.RECEIVER_NOT_EXPORTED);
+            mContext.getContentResolver().registerContentObserver(Settings.Secure.getUriFor(
+                    Settings.Secure.SLEEP_MODE_ENABLED), false, mSettingsObserver,
+                    UserHandle.USER_ALL);
+        }
+
+        void update() {
+            final boolean enabled = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                    Settings.Secure.SLEEP_MODE_ENABLED, 0, UserHandle.USER_CURRENT) == 1;
+            setSleepMode(enabled);
+        }
+
+        private void setSleepMode(boolean enabled) {
+            if (mSleepModeEnabled == enabled) return;
+            mSleepModeEnabled = enabled;
+            if (enabled) {
+                enable();
+            } else {
+                disable();
+            }
+        }
+
+        private void enable() {
+            if (!ActivityManager.isSystemReady()) return;
+
+            if (getSecureBoolean(Settings.Secure.SLEEP_MODE_WIFI_TOGGLE, true)) {
+                mWifiState = isWifiEnabled();
+                setWifiEnabled(false);
+            }
+            if (getSecureBoolean(Settings.Secure.SLEEP_MODE_BLUETOOTH_TOGGLE, true)) {
+                mBluetoothState = isBluetoothEnabled();
+                setBluetoothEnabled(false);
+            }
+            if (getSecureBoolean(Settings.Secure.SLEEP_MODE_CELLULAR_TOGGLE, true)) {
+                final TelephonyManager telephonyManager = getTelephonyManager();
+                if (telephonyManager != null) {
+                    mCellularState = telephonyManager.isDataEnabled();
+                    telephonyManager.setDataEnabled(false);
+                }
+            }
+            if (getSecureBoolean(Settings.Secure.SLEEP_MODE_SENSORS_TOGGLE, true)) {
+                setSensorsEnabled(false);
+            }
+
+            final int ringerMode = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                    Settings.Secure.SLEEP_MODE_RINGER_MODE, 0, UserHandle.USER_CURRENT);
+            if (ringerMode != 0 && mAudioManager != null && mNotificationManager != null) {
+                mRingerState = mAudioManager.getRingerModeInternal();
+                mZenState = mNotificationManager.getZenMode();
+                if (ringerMode == 1) {
+                    mAudioManager.setRingerModeInternal(AudioManager.RINGER_MODE_VIBRATE);
+                    mNotificationManager.setZenMode(ZEN_MODE_OFF, null, TAG);
+                } else if (ringerMode == 2) {
+                    mAudioManager.setRingerModeInternal(AudioManager.RINGER_MODE_NORMAL);
+                    mNotificationManager.setZenMode(ZEN_MODE_IMPORTANT_INTERRUPTIONS, null, TAG);
+                } else if (ringerMode == 3) {
+                    mAudioManager.setRingerModeInternal(AudioManager.RINGER_MODE_SILENT);
+                    mNotificationManager.setZenMode(ZEN_MODE_OFF, null, TAG);
+                }
+            }
+
+            showToast(R.string.sleep_mode_enabled_toast);
+            addNotification();
+        }
+
+        private void disable() {
+            if (!ActivityManager.isSystemReady()) return;
+
+            if (getSecureBoolean(Settings.Secure.SLEEP_MODE_WIFI_TOGGLE, true)
+                    && mWifiState != isWifiEnabled()) {
+                setWifiEnabled(mWifiState);
+            }
+            if (getSecureBoolean(Settings.Secure.SLEEP_MODE_BLUETOOTH_TOGGLE, true)
+                    && mBluetoothState != isBluetoothEnabled()) {
+                setBluetoothEnabled(mBluetoothState);
+            }
+            if (getSecureBoolean(Settings.Secure.SLEEP_MODE_CELLULAR_TOGGLE, true)) {
+                final TelephonyManager telephonyManager = getTelephonyManager();
+                if (telephonyManager != null && mCellularState != telephonyManager.isDataEnabled()) {
+                    telephonyManager.setDataEnabled(mCellularState);
+                }
+            }
+            if (getSecureBoolean(Settings.Secure.SLEEP_MODE_SENSORS_TOGGLE, true)) {
+                setSensorsEnabled(true);
+            }
+
+            final int ringerMode = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                    Settings.Secure.SLEEP_MODE_RINGER_MODE, 0, UserHandle.USER_CURRENT);
+            if (ringerMode != 0 && mAudioManager != null && mNotificationManager != null
+                    && (mRingerState != mAudioManager.getRingerModeInternal()
+                    || mZenState != mNotificationManager.getZenMode())) {
+                mAudioManager.setRingerModeInternal(mRingerState);
+                mNotificationManager.setZenMode(mZenState, null, TAG);
+            }
+
+            showToast(R.string.sleep_mode_disabled_toast);
+            if (mNotificationManager != null) {
+                mNotificationManager.cancel(SLEEP_NOTIFICATION_ID);
+            }
+        }
+
+        private boolean getSecureBoolean(String key, boolean def) {
+            return Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                    key, def ? 1 : 0, UserHandle.USER_CURRENT) == 1;
+        }
+
+        private TelephonyManager getTelephonyManager() {
+            int subId = SubscriptionManager.getDefaultDataSubscriptionId();
+            if (!SubscriptionManager.isValidSubscriptionId(subId)) {
+                final SubscriptionManager sm = mContext.getSystemService(SubscriptionManager.class);
+                final int[] activeSubIds = sm != null ? sm.getActiveSubscriptionIdList() : null;
+                if (activeSubIds != null && activeSubIds.length > 0) {
+                    subId = activeSubIds[0];
+                }
+            }
+            final TelephonyManager tm = mContext.getSystemService(TelephonyManager.class);
+            return tm != null && SubscriptionManager.isValidSubscriptionId(subId)
+                    ? tm.createForSubscriptionId(subId) : tm;
+        }
+
+        private boolean isWifiEnabled() {
+            try {
+                return mWifiManager != null && mWifiManager.isWifiEnabled();
+            } catch (RuntimeException e) {
+                return false;
+            }
+        }
+
+        private void setWifiEnabled(boolean enabled) {
+            try {
+                if (mWifiManager != null) mWifiManager.setWifiEnabled(enabled);
+            } catch (RuntimeException ignored) {
+            }
+        }
+
+        private boolean isBluetoothEnabled() {
+            try {
+                return mBluetoothAdapter != null && mBluetoothAdapter.isEnabled();
+            } catch (RuntimeException e) {
+                return false;
+            }
+        }
+
+        private void setBluetoothEnabled(boolean enabled) {
+            try {
+                if (mBluetoothAdapter == null) return;
+                if (enabled) {
+                    mBluetoothAdapter.enable();
+                } else {
+                    mBluetoothAdapter.disable();
+                }
+            } catch (RuntimeException ignored) {
+            }
+        }
+
+        private void setSensorsEnabled(boolean enabled) {
+            try {
+                if (mSensorPrivacyManager != null) {
+                    mSensorPrivacyManager.setAllSensorPrivacy(!enabled);
+                }
+            } catch (RuntimeException ignored) {
+            }
+        }
+
+        private void addNotification() {
+            if (mNotificationManager == null) return;
+            final Intent intent = new Intent(ACTION_TURN_OFF);
+            final PendingIntent pendingIntent = PendingIntent.getBroadcast(mContext, 0, intent,
+                    PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+            final Notification notification = new Notification.Builder(mContext,
+                    SystemNotificationChannels.SLEEP_MODE)
+                    .setTicker(mContext.getString(R.string.sleep_mode_notification_title))
+                    .setContentTitle(mContext.getString(R.string.sleep_mode_notification_title))
+                    .setContentText(mContext.getString(R.string.sleep_mode_notification_content))
+                    .setSmallIcon(R.drawable.ic_sleep)
+                    .setWhen(java.lang.System.currentTimeMillis())
+                    .setOngoing(true)
+                    .setContentIntent(pendingIntent)
+                    .setAutoCancel(false)
+                    .build();
+            mNotificationManager.notify(SLEEP_NOTIFICATION_ID, notification);
+        }
+
+        private void showToast(int resId) {
+            mHandler.post(() -> Toast.makeText(mContext, resId, Toast.LENGTH_LONG).show());
+        }
+    }
