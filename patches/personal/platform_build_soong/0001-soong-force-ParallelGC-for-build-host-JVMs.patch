From d304df06dc4ece35d89b72a810292d6a49020073 Mon Sep 17 00:00:00 2001
From: LieppOS <lieppos@localhost>
Date: Sat, 29 Aug 2026 12:57:17 +0300
Subject: [PATCH] soong: force ParallelGC for build-host JVMs

Every host JVM crash recorded on this tree is a SIGSEGV inside a G1
frame (G1ParScanThreadState::do_oop_evac, G1RegionMarkStatsCache::
add_live_words). jdk21/jdk25 both default to G1; on the Threadripper
2990WX build host the dieless NUMA nodes 1 and 3 expose races in G1's
concurrent marker.

build.sh tried to fix this with JAVA_TOOL_OPTIONS=-XX:+UseParallelGC,
but Soong constructs each JVM command line from javaVmFlagsList /
javacVmFlagsList / dexerJavaVmFlagsList, so the environment variable
never reached the processes that were crashing -- all 12 recorded
hs_err dumps show plain G1 with no ParallelGC flag.

Set the flag where Soong actually reads it. Verified accepted on
jdk8/jdk21/jdk25; UseDynamicNumberOfGCThreads is honoured by ParallelGC
so it is kept.

Change-Id: I353468f8b23f5c5e8827f70b2020e41bf49c8eeb
---
 java/config/config.go | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/java/config/config.go b/java/config/config.go
index 2b539abd7..aa8b168e6 100644
--- a/java/config/config.go
+++ b/java/config/config.go
@@ -55,16 +55,32 @@ var (
 )
 
 var (
-	JavacVmFlags    = strings.Join(javacVmFlagsList, " ")
+	JavacVmFlags = strings.Join(javacVmFlagsList, " ")
+	// LieppOS: force ParallelGC for every build-host JVM (javac, kotlinc, r8/d8,
+	// metalava, turbine).
+	//
+	// On the Threadripper 2990WX build host, nodes 1 and 3 are dieless: threads
+	// scheduled there reach memory only through a remote hop, which exposes
+	// races inside HotSpot's G1 collector. Every recorded host crash on this
+	// tree was a SIGSEGV in a G1 frame (G1ParScanThreadState::do_oop_evac,
+	// G1RegionMarkStatsCache::add_live_words). ParallelGC has no concurrent
+	// marker and does not hit them.
+	//
+	// This has to live here rather than in JAVA_TOOL_OPTIONS: Soong builds each
+	// JVM command line from these lists, so an environment variable set by
+	// build.sh never lands in the flags the crashing processes actually run
+	// with. Keep -XX:+UseDynamicNumberOfGCThreads — ParallelGC honours it too.
 	javaVmFlagsList = []string{
 		`-XX:OnError="cat hs_err_pid%p.log"`,
 		"-XX:CICompilerCount=6",
 		"-XX:+UseDynamicNumberOfGCThreads",
+		"-XX:+UseParallelGC",
 	}
 	javacVmFlagsList = []string{
 		`-J-XX:OnError="cat hs_err_pid%p.log"`,
 		"-J-XX:CICompilerCount=6",
 		"-J-XX:+UseDynamicNumberOfGCThreads",
+		"-J-XX:+UseParallelGC",
 		"-J-XX:+TieredCompilation",
 		"-J-XX:TieredStopAtLevel=1",
 	}
@@ -72,6 +88,7 @@ var (
 		`-JXX:OnError="cat hs_err_pid%p.log"`,
 		"-JXX:CICompilerCount=6",
 		"-JXX:+UseDynamicNumberOfGCThreads",
+		"-JXX:+UseParallelGC",
 	}
 )
 
