-    static final int ROUTING_WATCHDOG_MS = 6000;
+    static final int ROUTING_WATCHDOG_MS = 60000;
 
     // Default delay used for presence checks
     static final int DEFAULT_PRESENCE_CHECK_DELAY = 125;
@@ -6663,4 +6663,3 @@ public class NfcService implements DeviceHostListener, ForegroundUtils.Callback
         return result;
     }
 }
