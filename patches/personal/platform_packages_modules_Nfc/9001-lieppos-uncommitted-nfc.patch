diff --git a/libnfc-nci/src/adaptation/NfcAdaptation.cc b/libnfc-nci/src/adaptation/NfcAdaptation.cc
index 9f2717bf5..d186df9b3 100644
--- a/libnfc-nci/src/adaptation/NfcAdaptation.cc
+++ b/libnfc-nci/src/adaptation/NfcAdaptation.cc
@@ -34,6 +34,7 @@
 
 #include <future>
 #include <thread>
+#include <unistd.h>
 
 #include "NfcVendorExtn.h"
 #include "debug_nfcsnoop.h"
@@ -192,10 +193,13 @@ void initializeNfcMuteTechRouteOptionFlag() {
 
 // Abort nfc service when AIDL process died.
 void HalAidlBinderDied(void* /* cookie */) {
-  LOG(ERROR) << StringPrintf("%s: INfc aidl hal died, exiting procces to restart", __func__);
+  LOG(ERROR) << StringPrintf(
+      "%s: INfc aidl hal died, exiting process to restart", __func__);
   storeNfcSnoopLogs(DEFAULT_CRASH_LOGS_PATH, DEFAULT_NFCSNOOP_FILE_SIZE);
   notifyHalBinderDied();
-  exit(0);
+  // Do not run process finalizers here. Zygisk modules loaded into app_process
+  // can crash in __cxa_finalize during NFC HAL death recovery.
+  _exit(0);
 }
 
 }  // namespace
@@ -267,7 +271,8 @@ class NfcHalDeathRecipient : public hidl_death_recipient {
     }
     mNfcDeathHal = NULL;
     notifyHalBinderDied();
-    exit(0);
+    // Keep HAL death recovery out of injected-library finalizers.
+    _exit(0);
   }
   void finalize() {
     if (mNfcDeathHal) {
