android_app_import {
    name: "TinyScreen",
    apk: "TinyScreen.apk",
    privileged: true,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp-permissions-tinyscreen.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-tinyscreen.xml",
    src: "privapp-permissions-tinyscreen.xml",
    sub_dir: "permissions",
}
